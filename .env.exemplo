# ADVAK 5.0 — Configuração do PostgreSQL
# Copie para ".env" e preencha sua senha
#
# IMPORTANTE: NÃO adicione ADVAK_DB_NAME aqui!
# Cada projeto cria seu próprio banco automaticamente:
#   banco_auto("biblioteca")  → cria banco "biblioteca"
#   banco_auto("escola")      → cria banco "escola"
#   banco_auto("minha_app")   → cria banco "minha_app"

ADVAK_DB_HOST=localhost
ADVAK_DB_PORT=5432
ADVAK_DB_USER=postgres
ADVAK_DB_PASS=sua_senha_aqui

# ── Outros bancos (conector único: banco.conectar("mysql") lê a variável do banco) ──
# Descomente e preencha. Se a senha tiver símbolos (@ : / #), escreva-os em formato %40 %3A %2F %23.
# ADVAK_POSTGRES_URL=postgresql://usuario:senha@localhost:5432/meu_banco
# ADVAK_MYSQL_URL=mysql://usuario:senha@localhost:3306/meu_banco
# ADVAK_MARIADB_URL=mariadb://usuario:senha@localhost:3306/meu_banco
# ADVAK_MSSQL_URL=mssql://usuario:senha@localhost:1433/meu_banco
# ADVAK_MONGODB_URL=mongodb://usuario:senha@localhost:27017/meu_banco
# ADVAK_REDIS_URL=redis://:senha@localhost:6379/0
# ADVAK_SQLITE_URL=sqlite:///dados/meu_app.db
#
# Só para os testes automáticos (use bancos de TESTE, nunca de produção):
# ADVAK_TESTE_MYSQL_URL=mysql://root:senha@localhost:3306/teste_advak
