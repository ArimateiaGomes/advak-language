//  Advak Language — Complete English Syntax Reference
//  Run: python advak.py run english_full.dk
// ════════════════════════════════════════════════════════════════

// ── 1. Variables & Types ─────────────────────────────────────────
let name    = "Arimatea";
const PI    = 3.14159;
let active  = true;
let empty   = null;
let score   = 9.5;
let items   = [1, 2, 3, 4, 5];
let user    = {name: "Ana", city: "Arraial", age: 25};

print(`name=${name}  PI=${PI}  active=${active}`);

// ── 2. Operators ─────────────────────────────────────────────────
print(2 ** 10);               // 1024
print(10 % 3);                // 1
print(null ?? "default");     // default
print(5 == 5);                // true
print(10 > 5 && 3 < 7);      // true
print(!false || false);       // true

// ── 3. Template strings ───────────────────────────────────────────
let a = 8; let b = 4;
print(`${a} + ${b} = ${a + b}`);
print(`${a} ** 2 = ${a ** 2}`);
print(`Hello, ${name}! Score: ${score}`);

// ── 4. Lists ──────────────────────────────────────────────────────
let nums = [5, 2, 8, 1, 9, 3];
nums.ordenar();
print(`sorted: ${nums}`);
nums.adicionar(99);
print(`size: ${nums.tamanho}  last: ${nums.ultimo}`);

// ── 5. Maps (objects) ─────────────────────────────────────────────
let product = {title: "Notebook", price: 2999.99, stock: 5};
print(product.title);
print(product["price"]);
product.discount = 0.1;
print(`with discount: ${product.discount}`);

// ── 6. Conditionals ───────────────────────────────────────────────
let grade = 78;
if (grade >= 90) {
    print("A — Excellent");
} else if (grade >= 70) {
    print("B — Passed");
} else if (grade >= 50) {
    print("C — Recovery");
} else {
    print("F — Failed");
}

// ── 7. Loops ──────────────────────────────────────────────────────
let fruits = ["apple", "banana", "grape"];
for (f in fruits) { print(`- ${f}`); }

for (let i = 1; i <= 3; i += 1) {
    print(`  step ${i}`);
}

let count = 3;
while (count > 0) {
    print(`  countdown: ${count}`);
    count -= 1;
}

// ── 8. Functions ──────────────────────────────────────────────────
function add(a, b) { return a + b; }
function greet(n, salutation = "Hello") { return `${salutation}, ${n}!`; }
function factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}
function clamp(val, min, max) {
    if (val < min) { return min; }
    if (val > max) { return max; }
    return val;
}

print(add(15, 27));
print(greet("Dev"));
print(greet("Dev", "Hi"));
print(factorial(6));
print(clamp(150, 0, 100));

// ── 9. Lambdas & Arrow functions ──────────────────────────────────
let double  = (x) => x * 2;
let square  = (x) => x ** 2;
let add10   = (x) => x + 10;
let isEven  = (x) => x % 2 == 0;

print(double(7));
print(square(9));

// Pipeline |>
print(3 |> double |> square |> add10);  // ((3*2)²)+10 = 46

// ── 10. Classes ───────────────────────────────────────────────────
class Shape {
    construtor(color) {
        isso.color = color;
    }
    describe() { return `Shape(${isso.color})`; }
}

class Circle extends Shape {
    construtor(color, radius) {
        isso.color  = color;
        isso.radius = radius;
    }
    area()     { return Mat.pi * isso.radius ** 2; }
    describe() { return `Circle(r=${isso.radius}, color=${isso.color})`; }
}

class Rectangle extends Shape {
    construtor(color, width, height) {
        isso.color  = color;
        isso.width  = width;
        isso.height = height;
    }
    area()     { return isso.width * isso.height; }
    describe() { return `Rect(${isso.width}x${isso.height}, ${isso.color})`; }
}

let c = new Circle("red", 5);
let r = new Rectangle("blue", 4, 6);
print(c.describe());
print(`circle area: ${c.area()}`);
print(r.describe());
print(`rect area:   ${r.area()}`);

// ── 11. Match / Switch ────────────────────────────────────────────
let day = 3;
match(day) {
    case 1: print("Monday");
    case 2: print("Tuesday");
    case 3: print("Wednesday");
    case 4: print("Thursday");
    case 5: print("Friday");
    default: print("Weekend");
}

function letterGrade(n) {
    match(true) {
        case n >= 90: return "A";
        case n >= 80: return "B";
        case n >= 70: return "C";
        case n >= 60: return "D";
        default:      return "F";
    }
}
print(letterGrade(85));

// ── 12. Error handling ────────────────────────────────────────────
function divide(a, b) {
    if (b == 0) { throw "Division by zero!"; }
    return a / b;
}

try {
    print(divide(10, 2));
    print(divide(10, 0));
} catch (e) {
    print(`Error caught: ${e}`);
} finally {
    print("Finally always runs");
}

// ── 13. Standard library ──────────────────────────────────────────
// Math
print(Mat.raiz(144));
print(Mat.abs(-42));
print(Mat.piso(3.9));
print(Mat.teto(3.1));
print(Mat.max(1, 5, 3, 2, 4));
print(Mat.pi);

// Text
print(Texto.maiusculo("advak language"));
print(Texto.minusculo("HELLO WORLD"));
print(Texto.dividir("a,b,c,d", ","));
print(Texto.aparar("  spaces  "));
print(Texto.substituir("hello world", "world", "Advak"));

// List
let range = Lista.intervalo(1, 6);
print(range);

// JSON
let obj = {name: "Advak", version: 4, active: true};
let json_str = JSON.stringify(obj);
print(json_str);
let parsed = JSON.parse(json_str);
print(parsed.version);

// File
Arquivo.escrever("/tmp/advak_test.txt", "Advak English syntax!\nLine 2\nLine 3");
let content = Arquivo.ler("/tmp/advak_test.txt");
print(content);

// ── 14. Async / Await ─────────────────────────────────────────────
function async fetchUser(id) {
    return {id: id, name: `User ${id}`, active: true};
}
function async processUsers(ids) {
    let results = [];
    for (id in ids) {
        let u = fetchUser(id);
        results.adicionar(u);
    }
    return results;
}

let u1 = fetchUser(1);
print(`async user: ${u1.name}`);

