})

// ── API CRUD Alunos ─────────────────────────────────────────────────────

servidor.obter("/api/alunos", (req) => {
    seja turma   = req.consulta.turma
    seja min_nota = numero(req.consulta.nota_min ?? "0")
    seja limite  = inteiro(req.consulta.limite ?? "100")

    seja where = "WHERE 1=1"
    seja params = []
    seja i = [1]

    se (turma != nulo e turma != "") {
        where = where + " AND turma=$" + texto(i[0])
        params.adicionar(turma)
        i[0]++
    }
    se (min_nota > 0) {
        where = where + " AND nota>=$" + texto(i[0])
        params.adicionar(min_nota)
        i[0]++
    }

    seja alunos = banco.sql(
        "SELECT * FROM alunos " + where + " ORDER BY nome LIMIT " + texto(limite),
        params)

    retornar resposta_json({
        total:  alunos.tamanho,
        alunos: alunos
    })
})

servidor.obter("/api/alunos/:id", (req) => {
    seja id = inteiro(req.parametros.id)
    seja r = banco.sql("SELECT * FROM alunos WHERE id=$1", [id])
    se (r.tamanho == 0) {
        retornar resposta_json({erro: "Aluno não encontrado", id: id}, 404)
    }
    retornar resposta_json(r[0])
})

servidor.publicar("/api/alunos", (req) => {
    seja d = req.dados
    se (d == nulo ou d.nome == nulo) {
        retornar resposta_json({erro: "Campo 'nome' é obrigatório"}, 400)
    }
    seja r = banco.sql(
        "INSERT INTO alunos (nome,email,turma,nota) VALUES ($1,$2,$3,$4) RETURNING *",
        [d.nome, d.email ?? "", d.turma ?? "1A", numero(d.nota ?? 0)])
    retornar resposta_json({mensagem: "Aluno criado!", aluno: r[0]}, 201)
})

servidor.atualizar("/api/alunos/:id", (req) => {
    seja id = inteiro(req.parametros.id)
    seja d  = req.dados
    se (d == nulo) {
        retornar resposta_json({erro: "Corpo JSON inválido"}, 400)
    }
    banco.sql(
        "UPDATE alunos SET nome=$1,email=$2,turma=$3,nota=$4 WHERE id=$5",
        [d.nome, d.email, d.turma, numero(d.nota), id])
    retornar resposta_json({mensagem: "Aluno atualizado!", id: id})
})

servidor.deletar("/api/alunos/:id", (req) => {
    seja id = inteiro(req.parametros.id)
    seja r = banco.sql("SELECT id FROM alunos WHERE id=$1", [id])
    se (r.tamanho == 0) {
        retornar resposta_json({erro: "Aluno não encontrado"}, 404)
    }
    banco.sql("DELETE FROM alunos WHERE id=$1", [id])
    retornar resposta_json({mensagem: "Aluno removido!", id: id})
})

// ── Estatísticas ─────────────────────────────────────────────────────────

servidor.obter("/api/estatisticas", (req) => {
    seja stats = banco.sql(`
        SELECT
            COUNT(*) total,
            AVG(nota) media,
            MAX(nota) maior,
            MIN(nota) menor,
            COUNT(*) FILTER (WHERE nota>=7) aprovados,
            COUNT(*) FILTER (WHERE nota<7 AND nota>=5) recuperacao,
            COUNT(*) FILTER (WHERE nota<5) reprovados
        FROM alunos`)
    seja por_turma = banco.sql(
        "SELECT turma, COUNT(*) alunos, AVG(nota) media FROM alunos GROUP BY turma ORDER BY turma")
    retornar resposta_json({
        geral:     stats[0],
        por_turma: por_turma
    })
})

// ── Dashboard Visual ──────────────────────────────────────────────────────

servidor.obter("/dashboard", (req) => {
    seja alunos = banco.sql("SELECT * FROM alunos ORDER BY nome")
    seja rows = alunos.mapear((a) => {
        seja cor = numero(a.nota) >= 7 ? "#22C55E" : numero(a.nota) >= 5 ? "#F59E0B" : "#EF4444"
        seja sit = numero(a.nota) >= 7 ? "Aprovado" : numero(a.nota) >= 5 ? "Recuperação" : "Reprovado"
        retornar `<tr>
          <td>${texto(a.id)}</td>
          <td><b>${texto(a.nome)}</b></td>
          <td>${texto(a.email)}</td>
          <td><span style="background:#1E3A5F;color:#93C5FD;padding:2px 10px;border-radius:6px">${texto(a.turma)}</span></td>
          <td><b style="color:${cor}">${texto(a.nota)}</b></td>
          <td><span style="color:${cor}">${sit}</span></td>
        </tr>`
    }).unir("\n")

    retornar html(`<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><title>Dashboard Escola</title>
<style>
  body{font-family:'Segoe UI',sans-serif;background:#0F172A;color:#F1F5F9;padding:24px}
  h1{color:#60A5FA;margin-bottom:8px}
  .sub{color:#64748B;margin-bottom:24px}
  table{width:100%;border-collapse:collapse;background:#1E293B;border-radius:12px;overflow:hidden}
  th{background:#0F172A;padding:12px 16px;text-align:left;color:#94A3B8;font-size:12px;
     text-transform:uppercase;letter-spacing:1px}
  td{padding:12px 16px;border-bottom:1px solid #334155;font-size:14px}
  tr:last-child td{border-bottom:none}
  tr:hover td{background:rgba(59,130,246,0.05)}
  .back{color:#64748B;font-size:13px;display:inline-block;margin-bottom:16px}
</style></head>
<body>
  <a href="/" class="back">← Início</a>
  <h1>🎓 Dashboard — Escola</h1>
  <p class="sub">${texto(alunos.tamanho)} alunos cadastrados</p>
  <table>
    <thead><tr><th>ID</th><th>Nome</th><th>Email</th><th>Turma</th><th>Nota</th><th>Situação</th></tr></thead>
    <tbody>${rows}</tbody>
  </table>
</body></html>`)
})

// Página de teste POST
servidor.obter("/testar-post", (req) => {
    retornar html(`<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><title>Testar POST</title>
<style>
  body{font-family:'Segoe UI',sans-serif;background:#0F172A;color:#F1F5F9;
       display:flex;align-items:center;justify-content:center;height:100vh;margin:0}
  .card{background:#1E293B;border-radius:16px;padding:32px;min-width:360px;border:1px solid #334155}
  h2{color:#60A5FA;margin-bottom:20px}
  input{width:100%;background:#0F172A;border:1px solid #334155;color:#F1F5F9;
        padding:10px 14px;border-radius:8px;font-size:14px;margin-bottom:12px;box-sizing:border-box}
  button{width:100%;background:#3B82F6;color:white;border:none;padding:12px;
         border-radius:8px;font-size:15px;font-weight:600;cursor:pointer}
  button:hover{background:#2563EB}
  .res{margin-top:16px;background:#0F172A;border-radius:8px;padding:14px;
       font-family:monospace;font-size:13px;color:#34D399;display:none}
  a{color:#64748B;font-size:13px;display:block;margin-top:12px}
</style>
<script>
async function enviar() {
  const dados = {
    nome:  document.getElementById('nome').value,
    email: document.getElementById('email').value,
    turma: document.getElementById('turma').value,
    nota:  parseFloat(document.getElementById('nota').value)
  }
  const r = await fetch('/api/alunos', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(dados)
  })
  const json = await r.json()
  const res = document.getElementById('resultado')
  res.style.display = 'block'
  res.textContent = JSON.stringify(json, null, 2)
}
</script></head>
<body>
<div class="card">
  <h2>➕ Criar Novo Aluno (POST)</h2>
  <input id="nome" placeholder="Nome completo" value="Maria Santos">
  <input id="email" placeholder="Email" value="maria@escola.br">
  <input id="turma" placeholder="Turma" value="3A">
  <input id="nota" type="number" placeholder="Nota (0-10)" value="8.5" step="0.1">
  <button onclick="enviar()">Enviar POST /api/alunos</button>
  <pre id="resultado" class="res"></pre>
  <a href="/dashboard">Ver Dashboard →</a>
</div>
</body></html>`)
})

imprimir("🎓 API Escola iniciando na porta 8080...")
servidor.iniciar(8080)
