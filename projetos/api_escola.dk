// ═══════════════════════════════════════════════════════════════════════
//  ADVAK 5.0 — API REST Escola com PostgreSQL
//  Execute: advak projetos\api_escola.dk --db
//  Acesse:  http://localhost:8080
// ═══════════════════════════════════════════════════════════════════════

// Setup banco
funcao setup() {
    banco.sql(`CREATE TABLE IF NOT EXISTS alunos (
        id SERIAL PRIMARY KEY,
        nome VARCHAR(100) NOT NULL,
        email VARCHAR(100),
        turma VARCHAR(10),
        nota DECIMAL(5,2),
        criado_em TIMESTAMP DEFAULT NOW()
    )`)
    banco.sql(`INSERT INTO alunos (nome,email,turma,nota) VALUES
        ('Ana Silva','ana@escola.br','3A',9.5),
        ('Bruno Costa','bruno@escola.br','2B',7.0),
        ('Carla Lima','carla@escola.br','3A',8.5),
        ('Diego Melo','diego@escola.br','1C',6.0)
        ON CONFLICT DO NOTHING`)
}

tentar { setup() } pegar (e) { imprimir("Banco: " + texto(e)) }

servidor.porta(8080)

// ── Página inicial com documentação ────────────────────────────────────
servidor.obter("/", (req) => {
    retornar html(`<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="UTF-8"><title>API Escola — Advak 5.0</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Segoe UI',sans-serif;background:#0F172A;color:#F1F5F9;padding:32px}
  .header{border-bottom:1px solid #334155;padding-bottom:20px;margin-bottom:32px}
  .badge{background:#3B82F6;color:white;padding:4px 12px;border-radius:999px;font-size:12px;font-weight:700}
  h1{font-size:32px;color:#FFFFFF;margin:12px 0 4px}
  .sub{color:#64748B;margin-bottom:0}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}
  .route{background:#1E293B;border-radius:12px;padding:20px;border:1px solid #334155}
