    {icone: "📢", titulo: "Dialogos e Notificacoes",   descricao: "Alertas, toast, modal e confirmacoes",          teoria: T5,  codigo: C5},
    {icone: "🎨", titulo: "Cards, Abas e Visuais",     descricao: "Card, abas, slider, badge, busca",              teoria: T6,  codigo: C6},
    {icone: "✨", titulo: "Animacoes CSS",             descricao: "Mover, colorir e animar widgets",               teoria: T7,  codigo: C7},
    {icone: "🔗", titulo: "MVVM - Binding Reativo",    descricao: "Sincronizar dados e interface automaticamente",  teoria: T8,  codigo: C8},
    {icone: "🔄", titulo: "Drag e Drop — Kanban",      descricao: "Arrastar e soltar, painel Kanban",              teoria: T9,  codigo: C9},
    {icone: "📱", titulo: "App Completo — CRUD",       descricao: "Aplicacao completa de cadastro",                teoria: T10, codigo: C10}
]

// ═══════════════════════════════════════════════════════════════════════
//  LAYOUT PRINCIPAL
