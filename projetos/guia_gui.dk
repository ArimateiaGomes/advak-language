fixo C10 = `// App CRUD completo — Gestao de Contatos
gui.tema("escuro")
seja jan = gui.janela("Contatos — Advak App", 900, 600)

// Dados
seja contatos = [
    {nome: "Ana Silva",   email: "ana@email.com",   fone: "(11) 99999-1111"},
    {nome: "Bruno Lima",  email: "bruno@email.com",  fone: "(21) 98888-2222"},
    {nome: "Carla Matos", email: "carla@email.com",  fone: "(31) 97777-3333"}
]

// Layout
seja f_topo = gui.frame(jan, cor="#1E293B")
gui.label(f_topo, "  Gestao de Contatos", negrito=verdadeiro, tamanho=13, cor="#3B82F6")

gui.separador(jan)

seja f_main = gui.frame_horizontal(jan)

// Formulario lateral
seja f_form = gui.frame(f_main, cor="#0F172A")
f_form.posicionar(lado="left", preencher="y", expandir=falso)
f_form.configure(width=280)
f_form.pack_propagate(falso)

gui.label(f_form, "  Nome:", negrito=verdadeiro)
seja c_nome  = gui.campo(f_form, placeholder="Nome completo", largura=32)
gui.label(f_form, "  Email:", negrito=verdadeiro)
seja c_email = gui.campo(f_form, placeholder="Email", largura=32)
gui.label(f_form, "  Fone:", negrito=verdadeiro)
seja c_fone  = gui.campo(f_form, placeholder="(00) 00000-0000", largura=32)

gui.separador(f_form)
gui.botao(f_form, "  Adicionar", ao_clicar=() => adicionar(), estilo="sucesso",    largura=30)
gui.botao(f_form, "  Remover",   ao_clicar=() => remover(), estilo="perigo",     largura=30)
gui.botao(f_form, "  Limpar",    ao_clicar=() => limpar(), estilo="secundario", largura=30)

// DataGrid
seja f_grid = gui.frame(f_main)
seja cols = [
    {nome: "nome",  largura: 200},
    {nome: "email", largura: 220},
    {nome: "fone",  largura: 160}
]
seja dg = gui.datagrid(f_grid, cols,
    dados=contatos, editavel=verdadeiro, filtro=verdadeiro,
    ao_selecionar=(linha) => {
        c_nome.definir(linha.nome)
        c_email.definir(linha.email)
        c_fone.definir(linha.fone)
    })

seja st = gui.barra_status(jan, "  3 contatos carregados")

// Funcoes CRUD
funcao adicionar() {
    seja nome  = c_nome.get().aparar()
    seja email = c_email.get().aparar()
    seja fone  = c_fone.get().aparar()
    se (!nome || !email) {
        gui.aviso("Nome e email sao obrigatorios!")
        retornar
    }
    dg.adicionar({nome: nome, email: email, fone: fone})
    limpar()
    gui.toast("Contato adicionado!", "sucesso")
    st.mensagem("  " + texto(dg.dados.tamanho) + " contatos")
}

funcao remover() {
    seja sel = dg.selecionar()
    se (!sel) { gui.aviso("Selecione um contato"); retornar }
    seja ok = gui.confirmar("Remover " + sel.nome + "?")
    se (ok) { dg.remover(); gui.toast("Removido!", "aviso") }
}

funcao limpar() {
    c_nome.limpar(); c_email.limpar(); c_fone.limpar()
}

gui.iniciar()`

// ═══════════════════════════════════════════════════════════════════════
