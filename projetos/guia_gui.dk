// ═══════════════════════════════════════════════════════════════════════
//  ADVAK 5.0 — GUIA DE CRIAÇÃO DE APLICAÇÕES COM GUI
//  Execute: advak projetos\guia_gui.dk
// ═══════════════════════════════════════════════════════════════════════

gui.tema("escuro")
seja jan = gui.janela("Advak 5.0 — Guia de Aplicações GUI", 1250, 820)

// ═══════════════════════════════════════════════════════════════════════
//  TEORIAS (multiline com backticks)
// ═══════════════════════════════════════════════════════════════════════

fixo T1 = `Todo app GUI em Advak segue esta estrutura:

  1. Definir o tema (opcional)
  2. Criar a janela principal
  3. Adicionar widgets (label, botao, campo...)
  4. Definir funcoes para os eventos
  5. Iniciar o loop da interface

JANELA — gui.janela()
  gui.janela(titulo, largura, altura)
  Parametros opcionais:
    titulo  = 'Meu App'
    largura = 900
    altura  = 650

TEMAS disponiveis:
  gui.tema('escuro')   fundo escuro, texto claro
  gui.tema('claro')    fundo branco, texto escuro
  gui.tema('roxo')     tema violeta
  gui.tema('verde')    tema verde

  Tecla F11 alterna entre escuro/claro

INICIAR — sempre a ultima linha:
  gui.iniciar()   inicia o loop de eventos`

fixo T2 = `Frames organizam os widgets em regioes.

FRAME VERTICAL — gui.frame(pai)
  Empilha widgets de cima para baixo
  Parametros opcionais:
    cor   = '#1E293B'   cor de fundo hex
    borda = verdadeiro  mostra borda

FRAME HORIZONTAL — gui.frame_horizontal(pai)
  Alinha widgets da esquerda para direita
  Nao aceita parametro cor=

POSICIONAR — .posicionar()
  Controla onde o frame aparece:
    lado      = 'left' | 'right' | 'top' | 'bottom'
    preencher = 'both' | 'x' | 'y' | 'none'
    expandir  = verdadeiro | falso
    padx      = espaco horizontal
    pady      = espaco vertical

LAYOUT 2 COLUNAS:
  seja f_h  = gui.frame_horizontal(jan)
  seja col1 = gui.frame(f_h)   // coluna esquerda
  seja col2 = gui.frame(f_h)   // coluna direita

LAYOUT COM SIDEBAR:
  seja f_h      = gui.frame_horizontal(jan)
  seja sidebar  = gui.frame(f_h, cor='#0F172A')
  sidebar.posicionar(lado='left', preencher='y')
  sidebar.configure(width=200)
  sidebar.pack_propagate(falso)
  seja conteudo = gui.frame(f_h)`

fixo T3 = `Widgets para capturar dados do usuario:

CAMPO — gui.campo(pai)
  campo.get()         le o valor atual
  campo.definir(v)    define um valor
  campo.limpar()      apaga o conteudo
  Parametros:
    placeholder   = 'Digite...'
    valor_inicial = 'texto'
    senha         = verdadeiro  (oculta texto)
    largura       = 35
    ao_mudar      = funcao(v)

AREA DE TEXTO — gui.area_texto(pai)
  area.get('1.0','end-1c')   le todo o texto
  area.insert('end', txt)    insere texto
  area.delete('1.0','end')   apaga tudo
  Parametros: largura=50, altura=10

CHECKBOX — gui.checkbox(pai)
  Parametros:
    texto         = 'Ativar opcao'
    valor_inicial = falso
    ao_mudar      = funcao(v)

SLIDER — gui.slider(pai)
  slider.valor()    retorna numero atual
  Parametros: minimo=0, maximo=100, valor=50

SWITCH — gui.switch(pai, texto)
  Toggle moderno on/off

CAIXA DE SELECAO — gui.caixa_selecao(pai)
  sel.get()    retorna opcao selecionada
  Parametros: opcoes=['A','B'], valor_inicial='A'`

fixo T4 = `Exibir colecoes de dados:

TABELA SIMPLES — gui.tabela(pai, colunas)
  tabela.adicionar([v1, v2, v3])
  tabela.preencher([[v1,v2], [v3,v4]])
  tabela.selecionado()   retorna linha selecionada
  tabela.limpar()
  Parametros:
    colunas       = ['Col1', 'Col2']
    altura        = 10
    ao_selecionar = funcao(linha)

LISTA — gui.lista(pai)
  lista.adicionar(item)
  lista.selecionado()    retorna item
  lista.limpar()

ARVORE HIERARQUICA — gui.arvore(pai)
  Para dados com hierarquia pai/filho
  dados = [{nome, filhos: [{nome}]}]

DATAGRID EDITAVEL — gui.datagrid()
  Tabela com edicao inline por duplo clique
  colunas = [{nome:'Nome', largura:180}]

  dg = gui.datagrid(pai, colunas,
         dados=lista,
         editavel=verdadeiro,
         filtro=verdadeiro,
         ao_mudar=funcao(linha,col,val))

  dg.adicionar({nome:'X', valor:'Y'})
  dg.remover()
  dg.atualizar()
  dg.selecionar()   retorna linha selecionada`

fixo T5 = `Comunicar com o usuario:

ALERTAS — bloqueiam a interface:
  gui.alerta('Mensagem')      informacao
  gui.erro('Mensagem')        erro em vermelho
  gui.aviso('Mensagem')       aviso em amarelo
  gui.confirmar('Pergunta')   retorna verdadeiro/falso
  gui.pedir('Pergunta')       retorna texto digitado
  gui.pedir_numero('Prompt')  retorna numero

TOAST — notificacao flutuante (nao bloqueia):
  gui.toast('Mensagem', tipo, duracao)
  tipos:   'sucesso' | 'erro' | 'aviso' | 'info'
  duracao: 3000 (milissegundos)

DIALOGOS DE ARQUIVO:
  gui.escolher_arquivo()   retorna caminho
  gui.salvar_arquivo()     retorna caminho para salvar
  gui.escolher_pasta()     retorna pasta
  gui.escolher_cor()       retorna cor #hex

BARRA DE STATUS — rodape informativo:
  seja st = gui.barra_status(jan, 'Pronto')
  st.mensagem('Novo texto')
  st.ok('Operacao concluida')
  st.erro_st('Algo deu errado')`

fixo T6 = `Componentes visuais modernos:

CARD — gui.card(pai, titulo, corpo)
  Painel elevado com titulo e conteudo
  cor_borda = '#hex'  (opcional)

ABAS — gui.abas(pai)
  seja abas = gui.abas(jan)
  seja aba1 = abas.adicionar('Nome da Aba')
  // widgets vao dentro de aba1

SLIDER — gui.slider(pai)
  slider.valor()    le o valor atual
  Parametros:
    minimo   = 0
    maximo   = 100
    valor    = 50
    ao_mudar = funcao(v)
    label    = verdadeiro

SWITCH — gui.switch(pai, texto)
  Toggle moderno. ao_mudar=funcao(v)

BADGE — gui.badge(pai, texto, cor)
  Etiquetas coloridas para status
  cores: 'azul' | 'verde' | 'vermelho' | 'roxo'

SEPARADOR — gui.separador(pai)
  Linha divisoria horizontal

BUSCA — gui.busca(pai)
  Campo com autocomplete
  lista_itens   = ['A', 'B', 'C']
  ao_selecionar = funcao(valor)`

fixo T7 = `Animacoes fluidas estilo CSS transitions:

ANIMAR — gui.animar(widget, prop, valor)
  Anima qualquer propriedade suavemente

  Propriedades suportadas:
    'x'          move horizontal (via place)
    'y'          move vertical   (via place)
    'largura'    altera width
    'altura'     altera height
    'cor_fundo'  transicao de cor #hex
    'opacidade'  fade in/out

  Parametros:
    duracao  = 300   (milissegundos)
    easing   = 'ease_out'

  Easings disponiveis:
    'linear'       velocidade constante
    'ease_in'      comeca devagar
    'ease_out'     termina devagar
    'ease_in_out'  devagar nas pontas
    'bounce'       efeito elastico

SEQUENCIA — gui.animar_sequencia(lista)
  Executa animacoes em cadeia:
  gui.animar_sequencia([
    {widget:w, prop:'x',        valor:300, duracao:400},
    {widget:w, prop:'cor_fundo', valor:'#verde', duracao:500}
  ])

LOOP — gui.animar_loop(w, prop, v1, v2)
  Anima ida e volta infinitamente
  widget._anim_loop_stop()   para o loop`

fixo T8 = `MVVM separa dados (Model) da interface (View):

CRIAR VIEWMODEL:
  seja vm = gui.criar_viewmodel({
      nome:  'Ana',
      idade: 25,
      ativo: verdadeiro
  })

VINCULAR campo ao dado (bidirecional):
  vm.vincular(campo_entry, 'nome')
  Digitar no campo atualiza vm.dados.nome
  vm.definir('nome', 'X') atualiza o campo

VINCULAR label ao dado (leitura):
  vm.vincular_label(label, 'nome')
  vm.vincular_label(lbl, 'idade',
    formatar=funcao(v) { retornar v + ' anos' })

VINCULAR checkbox a booleano:
  vm.vincular_checkbox(check, 'ativo')

OBSERVAR mudancas:
  vm.ao_mudar('nome', funcao(v) {
      imprimir('Nome mudou para: ' + v)
  })

PROPRIEDADE COMPUTADA:
  vm.calcular('completo',
      funcao(n, s) { retornar n + ' ' + s },
      'nome', 'sobrenome')

LEITURA E ESCRITA DIRETA:
  vm.obter('nome')       le valor
  vm.definir('x', val)   atualiza tudo`

fixo T9 = `Drag and Drop para interfaces interativas:

HABILITAR DRAG em qualquer widget:
  gui.habilitar_drag(widget,
      dados={item: 'tarefa 1', id: 1},
      ao_iniciar=funcao(d) { },
      cursor='hand2')

HABILITAR DROP em area de destino:
  gui.habilitar_drop(frame,
      ao_soltar=funcao(dados, evento) {
          imprimir(dados.item)
      },
      realce=verdadeiro)   // azul ao passar

KANBAN COMPLETO — gui.kanban()
  Painel de cards arrastavel entre colunas:

  seja kb = gui.kanban(pai,
    colunas_config=[
      {titulo:'A Fazer', itens:['T1','T2'], cor:'#1e293b'},
      {titulo:'Fazendo', itens:[],          cor:'#1e3a5f'},
      {titulo:'Pronto',  itens:['T0'],      cor:'#14532d'}
    ],
    ao_mover=funcao(item, origem, destino) { }
  )

  API do Kanban:
    kb.adicionar(coluna_idx, 'novo item')
    kb.obter_colunas()   retorna [[itens]]
    kb.remover(col_idx, item)`

fixo T10 = `Padrao para um app CRUD completo:

ESTRUTURA RECOMENDADA:

  1. gui.tema() e gui.janela()

  2. DADOS (Model)
     seja registros = []

  3. LAYOUT (View)
     sidebar + area principal
     formulario + tabela/datagrid

  4. FUNCOES (ViewModel/Controller)
     funcao adicionar() { }
     funcao editar() { }
     funcao remover() { }
     funcao buscar(txt) { }

  5. EVENTOS
     botao → chama funcao
     tabela.ao_selecionar → preenche formulario

  6. gui.iniciar()   ← sempre por ultimo!

BOAS PRATICAS:
  Sempre validar antes de salvar
  Mostrar toast de feedback ao usuario
  Atualizar barra de status com contagem
  Confirmar antes de deletar
  Usar DataGrid para listas editaveis
  Usar MVVM para formularios reativos`

// ═══════════════════════════════════════════════════════════════════════
//  CODIGOS DE EXEMPLO
// ═══════════════════════════════════════════════════════════════════════

fixo C1 = `gui.tema("escuro")
seja jan = gui.janela("Meu Primeiro App", 600, 400)

gui.label(jan, "Ola, Mundo!", tamanho=24, negrito=verdadeiro, cor="#3B82F6")
gui.label(jan, "Este e meu primeiro app Advak GUI", tamanho=11)
gui.separador(jan)

seja campo = gui.campo(jan, placeholder="Digite algo...")

gui.botao(jan, "Mostrar mensagem",
    ao_clicar=() => {
        seja txt = campo.get()
        se (txt) {
            gui.alerta("Voce digitou: " + txt)
        } senao {
            gui.aviso("Campo vazio!")
        }
    }, estilo="sucesso")

seja status = gui.barra_status(jan, "Pronto")
gui.iniciar()`

fixo C2 = `gui.tema("escuro")
seja jan = gui.janela("Layout Demo", 700, 450)

// Barra de topo
seja f_topo = gui.frame(jan, cor="#1E293B")
gui.label(f_topo, "  Minha Aplicacao", negrito=verdadeiro, tamanho=13, cor="#3B82F6")

gui.separador(jan)

// Area principal: sidebar + conteudo
seja f_main = gui.frame_horizontal(jan)

seja sidebar = gui.frame(f_main, cor="#0F172A")
sidebar.posicionar(lado="left", preencher="y", expandir=falso)
sidebar.configure(width=180)
sidebar.pack_propagate(falso)

gui.label(sidebar, "  MENU", tamanho=9, negrito=verdadeiro, cor="#64748B")
gui.botao(sidebar, "  Inicio",    estilo="secundario", largura=22)
gui.botao(sidebar, "  Relatorio", estilo="secundario", largura=22)
gui.botao(sidebar, "  Config",    estilo="secundario", largura=22)

seja conteudo = gui.frame(f_main)
gui.label(conteudo, "Area de conteudo principal",
    negrito=verdadeiro, tamanho=14)
gui.label(conteudo, "Aqui ficam os dados e formularios da tela",
    cor="#64748B")

gui.barra_status(jan, "Layout com sidebar pronto!")
gui.iniciar()`

fixo C3 = `gui.tema("escuro")
