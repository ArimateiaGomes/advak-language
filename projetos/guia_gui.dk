fixo C5 = `gui.tema("escuro")
seja jan = gui.janela("Notificacoes Demo", 600, 500)

gui.label(jan, "Dialogos e Notificacoes", negrito=verdadeiro, tamanho=14)
gui.separador(jan)

seja st = gui.barra_status(jan, "Aguardando acao...")

// Toast - diferentes tipos
seja f1 = gui.frame_horizontal(jan)
gui.botao(f1, "Sucesso",
    ao_clicar=() => {
        gui.toast("Operacao realizada!", "sucesso")
        st.ok("Sucesso!")
    }, estilo="sucesso")
gui.botao(f1, "Erro",
    ao_clicar=() => {
        gui.toast("Algo deu errado!", "erro")
        st.erro_st("Erro")
    }, estilo="perigo")
gui.botao(f1, "Aviso",
    ao_clicar=() => gui.toast("Atencao necessaria", "aviso"), estilo="aviso")

gui.separador(jan)

gui.botao(jan, "Alerta simples",
    ao_clicar=() => gui.alerta("Este e um alerta informativo"))

gui.botao(jan, "Confirmacao",
    ao_clicar=() => {
        seja resp = gui.confirmar("Deseja continuar?")
        se (resp) { gui.toast("Confirmado!", "sucesso") }
        senao { gui.toast("Cancelado", "aviso") }
    })

gui.botao(jan, "Pedir texto",
    ao_clicar=() => {
        seja nome = gui.pedir("Qual e o seu nome?")
        se (nome) { gui.alerta("Ola, " + nome + "!") }
    })

gui.botao(jan, "Escolher arquivo",
    ao_clicar=() => {
        seja arq = gui.escolher_arquivo()
        se (arq) { gui.toast("Arquivo: " + arq, "info", 5000) }
    })

gui.iniciar()`

