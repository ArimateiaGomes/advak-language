fixo C7 = `gui.tema("escuro")
seja jan = gui.janela("Animacoes Demo", 700, 450)

gui.label(jan, "Animacoes CSS no Advak 5.0", negrito=verdadeiro, tamanho=14)
gui.separador(jan)

// Widget que sera animado
seja caixa = gui.frame(jan, cor="#2563EB", borda=verdadeiro)
caixa.place(x=50, y=120)
caixa.configure(width=100, height=50)
gui.label(caixa, "  Caixa  ", cor="#FFFFFF")

// Botoes de controle
seja f_btns = gui.frame_horizontal(jan)

gui.botao(f_btns, "Mover X",
    ao_clicar=() => gui.animar(caixa, "x", 450, duracao=600, easing="ease_out"), estilo="primario")

gui.botao(f_btns, "Mover Y",
    ao_clicar=() => gui.animar(caixa, "y", 250, duracao=400, easing="bounce"), estilo="primario")

gui.botao(f_btns, "Mudar Cor",
    ao_clicar=() => gui.animar(caixa, "cor_fundo", "#16A34A", duracao=800), estilo="sucesso")

gui.botao(f_btns, "Reset",
    ao_clicar=() => {
        gui.animar_sequencia([
            {widget: caixa, prop: "x",         valor: 50,        duracao: 400},
            {widget: caixa, prop: "y",         valor: 120,       duracao: 400},
            {widget: caixa, prop: "cor_fundo", valor: "#2563EB", duracao: 500}
        ])
    }, estilo="secundario")

gui.botao(f_btns, "Loop Infinito",
    ao_clicar=() => gui.animar_loop(caixa, "x", 50, 500, duracao=900, easing="ease_in_out"), estilo="aviso")

gui.botao(f_btns, "Parar",
    ao_clicar=() => {
        se (caixa._anim_loop_stop) { caixa._anim_loop_stop() }
    }, estilo="perigo")

gui.iniciar()`

fixo C8 = `gui.tema("escuro")
seja jan = gui.janela("MVVM Demo", 750, 500)

gui.label(jan, "MVVM — Binding Reativo", negrito=verdadeiro, tamanho=14)
gui.separador(jan)

// Criar ViewModel com dados iniciais
seja vm = gui.criar_viewmodel({
    nome:      "Maria",
    sobrenome: "Silva",
    email:     "maria@email.com",
    ativo:     verdadeiro
})

// Propriedade computada automatica
vm.calcular("completo",
    (n, s) => { retornar n + " " + s },
    "nome", "sobrenome")

seja f_h = gui.frame_horizontal(jan)

// Coluna esquerda: formulario
seja col1 = gui.frame(f_h)
col1.posicionar(lado="left", preencher="both", expandir=verdadeiro)

gui.label(col1, "Formulario (View)", negrito=verdadeiro, cor="#3B82F6")
gui.separador(col1)

gui.label(col1, "Nome:")
seja c_nome = gui.campo(col1, placeholder="Nome")
vm.vincular(c_nome, "nome")

