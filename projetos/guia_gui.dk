seja f_principal = gui.frame_horizontal(jan)

// ── SIDEBAR ──────────────────────────────────────────────────────────
seja sidebar = gui.frame(f_principal, cor="#0F172A")
sidebar.posicionar(lado="left", preencher="y", expandir=falso)
sidebar.configure(width=230)
sidebar.pack_propagate(falso)

gui.label(sidebar, "  GUI Advak 5.0", negrito=verdadeiro, tamanho=12, cor="#3B82F6")
