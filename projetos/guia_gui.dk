gui.label(jan, "Email:")
seja c_email = gui.campo(jan, placeholder="usuario@email.com", largura=40)

gui.label(jan, "Senha:")
seja c_senha = gui.campo(jan, placeholder="senha secreta", senha=verdadeiro, largura=40)

gui.label(jan, "Perfil:")
seja sel_perfil = gui.caixa_selecao(jan,
    opcoes=["Administrador", "Editor", "Leitor"],
    valor_inicial="Leitor")

seja chk_news = gui.checkbox(jan, "Receber newsletter", valor_inicial=verdadeiro)
seja sw_ativo = gui.switch(jan, "Conta ativa")

