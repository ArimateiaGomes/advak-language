fixo SECOES = [
    {icone: "🏗️", titulo: "Estrutura Basica",        descricao: "Como montar qualquer app GUI em Advak",          teoria: T1,  codigo: C1},
    {icone: "🧱", titulo: "Layout com Frames",        descricao: "Organizar widgets em colunas e linhas",          teoria: T2,  codigo: C2},
    {icone: "🎛️", titulo: "Widgets de Entrada",       descricao: "Campo, area de texto, checkbox, slider, switch", teoria: T3,  codigo: C3},
