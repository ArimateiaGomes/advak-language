    state="disabled", bg="#0A0E1A",
    fg=C_VERDE, relief="flat",
    font="Consolas 10",
    padx=10, pady=6, bd=0,
    highlightthickness=0
)
console.pack(fill="both", expand=verdadeiro)

funcao console_escrever(txt, cor_txt) {
    console.configure(state="normal")
    console.insert("end", txt + "\n")
    console.see("end")
    console.configure(state="disabled")
}

funcao console_limpar() {
    console.configure(state="normal")
    console.delete("1.0", "end")
    console.configure(state="disabled")
}

