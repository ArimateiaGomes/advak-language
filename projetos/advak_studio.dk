// Lista de arquivos
seja lst_arquivos = gui.lista(f_sidebar, altura=35)
lst_arquivos.configure(bg=C_BG2, fg=C_TEXTO, selectbackground=C_SEL,
                       selectforeground=C_ACENTO, relief="flat",
                       font="Segoe UI 9", activestyle="none", bd=0)
lst_arquivos.pack(fill="both", expand=verdadeiro, padx=0)

// Scrollbar customizada para lista
// (tkinter não suporta scrollbar colorida via Advak — omitir)

funcao atualizar_explorador() {
    lst_arquivos.limpar()
    seja encontrado = falso
    seja arquivos = []

    tentar {
        arquivos = Arquivo.listar("projetos", ".dk")
        se (arquivos.tamanho > 0) { encontrado = verdadeiro }
    } pegar (e1) { }

    se (nao encontrado) {
        tentar {
            arquivos = Arquivo.listar(".", ".dk")
            se (arquivos.tamanho > 0) { encontrado = verdadeiro }
        } pegar (e2) { }
    }

    se (encontrado) {
        para (arq em arquivos) {
            seja nome = texto(arq)
            se (nome.contem("/") ou nome.contem("\\")) {
                seja pts = nome.substituir("\\", "/").dividir("/")
                nome = pts[pts.tamanho - 1]
            }
            lst_arquivos.adicionar("   " + nome)
        }
    } senão {
        lst_arquivos.adicionar("  (pasta não encontrada)")
    }
}

atualizar_explorador()

lst_arquivos.bind("<<ListboxSelect>>", (e) => {
    seja sel = lst_arquivos.selecionado()
    se (sel != nulo e sel.contem(".dk")) {
        seja nome = sel.aparar()
        se (nome != "") {
            abrir_arquivo("projetos/" + nome)
        }
    }
})

