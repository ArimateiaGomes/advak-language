funcao sidebar_tab(pai, txt, fn) {
    seja btn = gui.botao(pai, txt, ao_clicar=fn, estilo="secundario")
    btn.configure(bg=C_BG4, fg=C_TEXTO2, relief="flat", font="Segoe UI 8 bold",
                  padx=10, pady=6, bd=0, activebackground=C_BG3, cursor="hand2")
    btn.pack(side="left")
    retornar btn
}

