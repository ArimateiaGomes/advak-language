    opcoes=["⚡ Snippet..."] + SNIPPETS.chaves,
    valor_inicial="⚡ Snippet...")
caixa_snippet.pack(side="left", padx=4, pady=8)
caixa_snippet.configure(width=14, font="Segoe UI 9")

caixa_snippet.bind("<<ComboboxSelected>>", (e) => {
    seja escolha = caixa_snippet.get()
    se (escolha != "⚡ Snippet..." e SNIPPETS.contem(escolha)) {
        editor.insert("insert", "\n" + SNIPPETS[escolha] + "\n")
        caixa_snippet.set("⚡ Snippet...")
        editor.focus()
    }
})

