seja C_VERDE  = "#3FB950"   // sucesso
seja C_AMAREL = "#D29922"   // aviso
seja C_VERM   = "#F85149"   // erro
seja C_ROXO   = "#8957E5"   // especial
seja C_CIANO  = "#39C5CF"   // info
seja C_TEXTO  = "#E6EDF3"   // texto principal
