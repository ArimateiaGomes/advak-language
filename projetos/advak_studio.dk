// Função para criar botões de toolbar estilizados
funcao toolbar_btn(pai, emoji, texto_btn, fn, cor_bg, cor_txt) {
    // Criar botão diretamente no pai sem frame wrapper (evita expand=True do gui.frame)
    seja btn = gui.botao(pai, emoji + " " + texto_btn, ao_clicar=fn, estilo="primario")
    btn.configure(bg=cor_bg, fg=cor_txt, relief="flat",
                  activebackground=C_BG3, activeforeground=cor_txt,
                  font="Segoe UI 9 bold", padx=12, pady=6, bd=0,
                  cursor="hand2")
    btn.pack(side="left", padx=3, pady=6)
    retornar btn
}

seja btn_exec  = toolbar_btn(f_toolbar_inner, "▶", "Executar",  () => executar(),  "#1A3A1A", C_VERDE)
seja btn_parar = toolbar_btn(f_toolbar_inner, "⏹", "Parar",     () => parar(),     "#3A1A1A", C_VERM)
seja btn_verif = toolbar_btn(f_toolbar_inner, "✔", "Verificar", () => verificar(), "#2A2A1A", C_AMAREL)

// Separador
gui.label(f_toolbar_inner, " | ", tamanho=9, cor=C_TEXTO3).pack(side="left")

