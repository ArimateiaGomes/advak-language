editor.configure(
    bg=C_BG1, fg=C_TEXTO,
    insertbackground=C_ACENTO,
    selectbackground="#264F78",
    selectforeground=C_TEXTO,
    relief="flat",
    font="Consolas 11",
    wrap="none",
    padx=8, pady=4,
    bd=0, highlightthickness=0
)
editor.pack(side="left", fill="both", expand=verdadeiro)

// Código inicial
editor.insert("1.0", "// ═══════════════════════════════════════════\n//  Bem-vindo ao Advak Studio 5.1 ⚡\n//  Linguagem de Programação em Português\n// ═══════════════════════════════════════════\n\n// Olá Mundo\nimprimir(\"Olá, Advak!\")\n\n// Variáveis\nseja nome = \"Advak\"\nseja versao = 5.1\nimprimir(\"Linguagem: \" + nome + \" v\" + texto(versao))\n\n// Função\nfuncao saudacao(pessoa) {\n    retornar \"Olá, \" + pessoa + \"! 👋\"\n}\nimprimir(saudacao(\"Programador\"))\n\n// Lista\nseja linguagens = [\"Advak\", \"Python\", \"JavaScript\"]\npara (lang em linguagens) {\n    imprimir(\"  → \" + lang)\n}\n\n// Pressione F5 para executar!\n")

// Atualizar números de linha
funcao atualizar_num_linhas() {
    tentar {
        seja total_raw = editor.index("end-1c")
        seja total_pts = total_raw.dividir(".")
        se (total_pts.tamanho < 1) { retornar }
        seja total = inteiro(total_pts[0])

        num_linhas_txt.configure(state="normal")
        num_linhas_txt.delete("1.0", "end")
        seja nums = ""
        seja i = 1
        enquanto (i <= total) {
            nums = nums + texto(i) + "\n"
            i = i + 1
        }
        num_linhas_txt.insert("1.0", nums)
        num_linhas_txt.configure(state="disabled")
    } pegar (err) { }
}

atualizar_num_linhas()

// Atualizar ao editar
// ─── SYNTAX HIGHLIGHTING — Definição de cores ───────────────────────────
// Cores estilo VS Code Dark+ para Advak

// ─── SYNTAX HIGHLIGHTING via builtin Python ─────────────────────────────────
// aplicar_highlight_editor() é um builtin que usa tkinter/re direto
// Muito mais rápido e sem problemas de escape de strings

funcao aplicar_highlight() {
    tentar {
        aplicar_highlight_editor(editor)
    } pegar (err) {
        // Ignora erros de highlight silenciosamente
    }
}

// Aplicar configuração inicial das tags (feito dentro do builtin)
aplicar_highlight()

// ── KeyRelease atualizado com highlight ──────────────────────────────────
editor.bind("<KeyRelease>", (e) => {
    tentar {
        seja pos = editor.index("insert")
        seja pts = pos.dividir(".")
        se (pts.tamanho >= 2) {
            seja ln = pts[0]
            seja col = texto(inteiro(pts[1]) + 1)
            lbl_cursor.configure(text="  Ln " + ln + "  Col " + col)
        }
        atualizar_num_linhas()
        seja total_raw = editor.index("end-1c")
        seja total_pts = total_raw.dividir(".")
        se (total_pts.tamanho >= 1 e total_pts[0] != "New") {
            lbl_linhas.configure(text=total_pts[0] + " linhas  ")
        }
        _modificado[0] = verdadeiro
        lbl_modificado.configure(text=" ●")
        lbl_tab_nome.configure(text="  📄 " + (_arquivo_atual[0] != "" ?? _arquivo_atual[0].dividir("/").ultimo() ?? "Sem título") + "  ●  ×")
        // Aplicar syntax highlighting
        aplicar_highlight()
    } pegar (err) { }
})

