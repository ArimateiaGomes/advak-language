    "classe":   "classe Nome {\n    inicio() {\n        isso.prop = nulo\n    }\n}",
    "se/senão": "se (condicao) {\n    \n} senão {\n    \n}",
    "para":     "para (item em lista) {\n    imprimir(item)\n}",
    "enquanto": "enquanto (condicao) {\n    \n}",
    "tentar":   "tentar {\n    \n} pegar (erro) {\n    imprimir(erro)\n}",
    "servidor": "servidor.porta(8080)\nservidor.obter(\"/\", (req) => {\n    retornar html(\"<h1>Olá!</h1>\")\n})\nservidor.iniciar(8080)",
    "banco":    "seja db = banco_auto(\"app\")\nseja t = db.criar_tabela(\"itens\", {\n    nome: \"texto\",\n    valor: \"numero\"\n})",
}

