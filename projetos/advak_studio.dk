// ═══════════════════════════════════════════════════════════════════════
// FUNÇÕES PRINCIPAIS
// ═══════════════════════════════════════════════════════════════════════

funcao executar() {
    se (_executando[0]) {
        gui.toast("Já está executando! Pressione F6 para parar.", "aviso", 2000)
        retornar
    }
    seja codigo = editor.get("1.0", "end")
    se (codigo.aparar() == "") {
        gui.toast("Editor vazio! Escreva algum código primeiro.", "aviso", 2000)
        retornar
    }
    console_limpar()
    console_escrever("▶ Executando...\n", C_VERDE)
    lbl_status_topo.configure(text="⏳ Executando...", fg=C_AMAREL)
    _executando[0] = verdadeiro
    tentar { abas_direito.selecionar(0) } pegar (e) { }
    studio_executar(codigo, console, lbl_status_topo, _executando)
}
funcao parar() {
    // Só mostrar "interrompida" se estava de fato executando
    se (_executando[0]) {
        _executando[0] = falso
        lbl_status_topo.configure(text="⏹ Parado", fg=C_VERM)
        console_escrever("⏹ Execução interrompida.", C_AMAREL)
    } senão {
        gui.toast("Nenhuma execução em andamento.", "info", 1500)
    }
}

funcao verificar() {
    seja codigo = editor.get("1.0", "end")
    seja arq_temp = "_studio_linter_temp.dk"
    Arquivo.escrever(arq_temp, codigo)

    linter_out.delete("1.0", "end")
    tentar { abas_direito.selecionar(3) } pegar (e) { }

    tentar {
        seja res = OS.executar("advak --verificar " + arq_temp)
        seja saida = (res.saida ?? "") + (res.erro ?? "")
        se (saida.contem("Nenhum problema")) {
            linter_out.configure(fg=C_VERDE)
            linter_out.insert("1.0", "✅ Nenhum problema encontrado!\n\nCódigo Advak válido.")
            lbl_status_topo.configure(text="✔ Código OK", fg=C_VERDE)
        } senão {
            linter_out.configure(fg=C_AMAREL)
            linter_out.insert("1.0", saida)
        }
    } pegar (e) {
        linter_out.insert("1.0", "Execute: advak --verificar arquivo.dk")
    }
}

funcao salvar() {
    seja codigo = editor.get("1.0", "end")
    seja caminho = _arquivo_atual[0]

    se (caminho == "") {
        caminho = gui.salvar_arquivo(tipos=[["Advak", "*.dk"], ["Todos", "*.*"]])
        se (caminho == nulo) { retornar }
        _arquivo_atual[0] = caminho
    }

    Arquivo.escrever(caminho, codigo)
    _modificado[0] = falso
    lbl_modificado.configure(text="")

    seja nome = caminho.substituir("\\", "/").dividir("/").ultimo() ?? caminho
    lbl_breadcrumb.configure(text="  projetos / " + nome)
    lbl_tab_nome.configure(text="  📄 " + nome + "  ×")
    lbl_status_topo.configure(text="💾 Salvo", fg=C_VERDE)
    gui.toast("Salvo: " + nome, "sucesso", 2000)
    atualizar_explorador()
}

funcao abrir() {
    seja caminho = gui.abrir_arquivo(tipos=[["Advak", "*.dk"], ["Todos", "*.*"]])
    se (caminho == nulo) { retornar }
    abrir_arquivo(caminho)
}

funcao abrir_arquivo(caminho) {
    tentar {
        seja conteudo = Arquivo.ler(caminho)
        editor.delete("1.0", "end")
        editor.insert("1.0", conteudo)
        atualizar_num_linhas()
        _arquivo_atual[0] = caminho
        _modificado[0] = falso
        lbl_modificado.configure(text="")
        seja nome = caminho.substituir("\\", "/").dividir("/").ultimo() ?? caminho
        lbl_breadcrumb.configure(text="  projetos / " + nome)
        lbl_tab_nome.configure(text="  📄 " + nome + "  ×")
        lbl_status_topo.configure(text="📂 " + nome, fg=C_VERDE)
        tentar { abas_direito.selecionar(0) } pegar (e) { }
        console_limpar()
        // Colorir sintaxe do arquivo aberto
        aplicar_highlight()
    } pegar (e) {
        gui.aviso("Erro ao abrir:\n" + texto(e))
    }
}

funcao novo() {
    se (_modificado[0]) {
        se (nao gui.confirmar("Arquivo modificado. Descartar mudanças?")) {
            retornar
        }
    }
    editor.delete("1.0", "end")
    editor.insert("1.0", "// Novo arquivo Advak\nimprimir(\"Olá!\")\n")
    atualizar_num_linhas()
    aplicar_highlight()
    _arquivo_atual[0] = ""
    _modificado[0] = falso
    lbl_modificado.configure(text="")
    lbl_breadcrumb.configure(text="  Sem título")
    lbl_tab_nome.configure(text="  📄 Sem título  ×")
    lbl_status_topo.configure(text="📄 Novo arquivo", fg=C_VERDE)
}

// ─── ATALHOS DE TECLADO ──────────────────────────────────────────────────
jan.bind("<F5>",        (e) => { executar() })
jan.bind("<F6>",        (e) => parar())
jan.bind("<F7>",        (e) => verificar())
jan.bind("<Control-s>", (e) => salvar())
jan.bind("<Control-S>", (e) => salvar())
jan.bind("<Control-n>", (e) => novo())
jan.bind("<Control-N>", (e) => novo())
jan.bind("<Control-o>", (e) => abrir())
jan.bind("<Control-O>", (e) => abrir())

// ─── INICIALIZAÇÃO ────────────────────────────────────────────────────────
atualizar_num_linhas()
lbl_status_topo.configure(text="✅ Advak Studio 5.1 pronto!", fg=C_VERDE)
gui.toast("⚡ Advak Studio 5.1  —  F5 para executar", "sucesso", 4000)

gui.iniciar()
