                       font="Consolas 9", padx=10, pady=8, bd=0, state="normal")
txt_atalhos.insert("1.0", "━━━ ATALHOS ━━━━━━━━━━━━━━━━━━━━━

  F5        ▶  Executar código
  F6        ⏹  Parar execução
  F7        ✔  Verificar sintaxe
  Ctrl+S    💾  Salvar arquivo
  Ctrl+N    📄  Novo arquivo
  Ctrl+O    📂  Abrir arquivo

━━━ SINTAXE ━━━━━━━━━━━━━━━━━━━━━

  seja x = 10
  fixo PI = 3.14159
  se (x > 0) { ... } senão { }
  para (i em lista) { }
  enquanto (cond) { }
  funcao f(a, b) { retornar a+b }
  classe Nome { inicio() {} }
  tentar { } pegar (e) { }
  lançar(\"mensagem\")
  assincrona funcao f() { }
  seja r = aguarda f()

━━━ TIPOS ━━━━━━━━━━━━━━━━━━━━━━━

  tipo(x)        → nome do tipo
  texto(x)       → converter texto
  numero(x)      → converter número
  inteiro(x)     → arredondar

━━━ LISTA ━━━━━━━━━━━━━━━━━━━━━━━

