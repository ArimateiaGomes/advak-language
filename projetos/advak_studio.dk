caixa_tema.configure(width=12, font="Segoe UI 9")

caixa_tema.bind("<<ComboboxSelected>>", (e) => {
    seja escolha = caixa_tema.get()
    se (escolha.contem("Claro")) {
        gui.tema("claro")
        lbl_status_topo.configure(text="☀️ Tema claro", fg=C_AMAREL)
    } senão se (escolha.contem("Oceano")) {
        gui.tema("azul")
        lbl_status_topo.configure(text="🌊 Tema oceano", fg=C_CIANO)
    } senão {
        gui.tema("escuro")
        lbl_status_topo.configure(text="🌑 Tema escuro", fg=C_TEXTO2)
    }
})

