// ═══════════════════════════════════════════════════════════════════════════
// SEÇÃO 5 — FUNÇÕES PDV
// ═══════════════════════════════════════════════════════════════════════════

funcao pdv_atualizar_tela() {
    tbl_itens.limpar()
    seja i = 1
    para (item em _venda.itens) {
        tbl_itens.adicionar([texto(i), item.nome.primeiros(26),
            texto(arred(item.quantidade, 3)),
            moeda(item.preco_unitario), moeda(item.subtotal)])
        i++
    }
    seja tl = total_liq()
    seja tb = total_bruto()
    seja n  = _venda.itens.tamanho
    seja d  = _venda.desconto

    // Total principal — cor muda com valor
    lbl_total.configure(text=moeda(tl))
    se (tl > 0) { lbl_total.configure(fg="#22C55E") }
    se (tl == 0) { lbl_total.configure(fg="#4B6B8A") }

    // Info venda
    lbl_info_venda.configure(text=texto(n) + (n==1?" item":" itens") +
        "  ·  " + (d>0?"Desc: "+moeda(d):"Sem desconto"))

    // Cards métricas
    lbl_m_itens.configure(text=texto(n))
    lbl_m_bruto.configure(text=moeda(tb))
    lbl_m_desc.configure(text=moeda(d), fg=(d>0?"#F59E0B":"#4B6B8A"))

    // Troco
    se (_forma[0] == "Dinheiro") {
        seja rec = numero(c_rec.get() ?? "0")
        seja tr  = arred(rec - tl, 2)
        lbl_troco.configure(
            text="  💰  Troco: " + moeda(tr),
            fg=tr >= 0 ? "#22C55E" : "#EF4444")
    }
}

funcao pdv_adicionar_produto(prod, qtd, desc_item) {
    se (prod.estoque_atual < qtd) {
        gui.aviso("⚠️  Estoque insuficiente!

" + prod.nome +
            "
Disponível: " + texto(prod.estoque_atual))
        retornar falso
    }
    seja idx = -1; seja i = 0
    para (item em _venda.itens) {
        se (item.produto_id == prod.id) { idx = i }
        i++
    }
    se (idx >= 0) {
        seja nq = _venda.itens[idx].quantidade + qtd
        _venda.itens[idx].quantidade = nq
        _venda.itens[idx].subtotal   = arred(nq * _venda.itens[idx].preco_unitario - _venda.itens[idx].desconto_item, 2)
    } senão {
        _venda.itens.adicionar({
            produto_id:    prod.id,
            nome:          prod.nome,
            quantidade:    qtd,
            preco_unitario:prod.preco_venda,
            desconto_item: desc_item,
            subtotal:      arred(qtd * prod.preco_venda - desc_item, 2)
        })
    }
    pdv_atualizar_tela()
    lbl_pnome.configure(text="  ✅  " + prod.nome, fg="#22C55E")
    lbl_pinfo.configure(
        text="  " + moeda(prod.preco_venda) + "  ·  Estoque: " + texto(prod.estoque_atual) +
             "  ·  " + (prod.categoria_nome ?? ""), fg="#4B6B8A")
    status_mensagem("  ✅  " + prod.nome + " adicionado — " + moeda(qtd * prod.preco_venda))
    retornar verdadeiro
}

funcao pdv_adicionar() {
    seja cod = c_cod.get().aparar()
    se (cod == "") { retornar }
    seja qtd  = numero(c_qtd.get() ?? "1")
    seja desc = numero(c_desc_item.get() ?? "0")
    seja prods = buscar_por_codigo_ou_nome(cod)
    se (prods.tamanho == 0) {
        lbl_pnome.configure(text="  ❌  Não encontrado: " + cod, fg="#EF4444")
        lbl_pinfo.configure(text="  Use código de barras ou parte do nome", fg="#F59E0B")
        gui.toast("Produto não encontrado!", "erro", 2000)
        retornar
    }
    se (prods.tamanho == 1) {
        se (pdv_adicionar_produto(prods[0], qtd, desc)) {
            c_cod.delete(0,"end")
            c_qtd.delete(0,"end"); c_qtd.insert(0,"1")
            c_desc_item.delete(0,"end"); c_desc_item.insert(0,"0")
            c_cod.focus()
        }
    } senão {
        tbl_bk.limpar()
        para (p em prods) {
            tbl_bk.adicionar([texto(p.codigo_barras), texto(p.nome),
                moeda(numero(p.preco_venda)), texto(p.estoque_atual)])
        }
        status_mensagem("  🔍  " + texto(prods.tamanho) + " resultados — clique na aba Buscar Produto")
    }
}

funcao pdv_buscar_nome() {
    seja b = gui.pedir("🔍  Buscar produto:
Digite parte do nome:")
    se (b == nulo ou b == "") { retornar }
    seja prods = buscar_por_codigo_ou_nome(b)
    tbl_bk.limpar()
    para (p em prods) {
        tbl_bk.adicionar([texto(p.codigo_barras), texto(p.nome),
            moeda(numero(p.preco_venda)), texto(p.estoque_atual)])
    }
    status_mensagem("  " + texto(prods.tamanho) + " produto(s) encontrado(s)")
}

funcao pdv_buscar_tabela() {
    seja b = c_bk.get().aparar()
    se (b == "") { retornar }
    seja prods = buscar_por_codigo_ou_nome(b)
    tbl_bk.limpar()
    para (p em prods) {
        tbl_bk.adicionar([texto(p.codigo_barras), texto(p.nome),
            moeda(numero(p.preco_venda)), texto(p.estoque_atual)])
    }
    status_mensagem("  " + texto(prods.tamanho) + " resultado(s)")
}

funcao pdv_add_da_busca(linha) {
    seja p = buscar_por_codigo_ou_nome(linha["Cód.Barras"])
    se (p.tamanho > 0) {
        seja qtd  = numero(c_qtd.get() ?? "1")
        seja desc = numero(c_desc_item.get() ?? "0")
        pdv_adicionar_produto(p[0], qtd, desc)
    }
}

funcao pdv_remover_item() {
    seja sel = tbl_itens.selecionado()
    se (sel == nulo) { gui.aviso("Selecione um item para remover!"); retornar }
    seja num = inteiro(sel["#"]) - 1
    se (num >= 0 e num < _venda.itens.tamanho) {
        seja nm = _venda.itens[num].nome
        _venda.itens.remover(num)
        pdv_atualizar_tela()
        status_mensagem("  🗑  Removido: " + nm)
    }
}

funcao pdv_editar_qtd() {
    seja sel = tbl_itens.selecionado()
    se (sel == nulo) { gui.aviso("Selecione um item!"); retornar }
    seja num = inteiro(sel["#"]) - 1
    seja nova = gui.pedir("Nova quantidade para:
" + _venda.itens[num].nome + ":")
    se (nova == nulo) { retornar }
    seja qtd = numero(nova)
    se (qtd <= 0) { gui.aviso("Quantidade inválida!"); retornar }
    _venda.itens[num].quantidade = qtd
    _venda.itens[num].subtotal   = arred(qtd * _venda.itens[num].preco_unitario - _venda.itens[num].desconto_item, 2)
    pdv_atualizar_tela()
}

funcao pdv_aplicar_desc() {
    seja d = numero(c_desc_tot.get() ?? "0")
    se (d < 0 ou d > total_bruto()) { gui.aviso("Desconto inválido!"); retornar }
    _venda.desconto = d
    pdv_atualizar_tela()
    status_mensagem("  🏷  Desconto de " + moeda(d) + " aplicado")
}

funcao pdv_sel_pag(forma) {
    _forma[0] = forma
    lbl_pag.configure(text="  ✅  " + forma.maiusculo() + " selecionado")
    se (forma == "Dinheiro") {
        c_rec.configure(estado="habilitado")
        lbl_pag.configure(fg="#22C55E")
    } senão {
        c_rec.configure(estado="desabilitado")
        c_rec.delete(0,"end"); c_rec.insert(0,"0")
        lbl_troco.configure(text="  💳  " + forma + " — sem troco")
        lbl_pag.configure(fg="#60A5FA")
    }
}

funcao pdv_limpar_venda() {
    se (_venda.itens.tamanho > 0) {
        se (nao gui.confirmar("Limpar todos os itens da venda?")) { retornar }
    }
    _venda.itens.limpar(); _venda.desconto = 0
    c_desc_tot.delete(0,"end"); c_desc_tot.insert(0,"0")
    pdv_atualizar_tela()
    lbl_pnome.configure(text="  Aguardando produto...", fg="#4B6B8A")
    lbl_pinfo.configure(text="")
    lbl_total.configure(fg="#4B6B8A")
    status_mensagem("  🧹  Venda limpa — pronto para nova venda")
}

funcao pdv_finalizar() {
    se (_venda.itens.tamanho == 0) {
        gui.aviso("Adicione produtos antes de finalizar!")
        retornar
    }
    seja tl   = total_liq()
    seja forma = _forma[0]
    seja rec  = numero(c_rec.get() ?? "0")

    se (forma == "Dinheiro" e rec < tl) {
        gui.aviso("⚠️  Valor recebido insuficiente!

Total:     " +
            moeda(tl) + "
Recebido:  " + moeda(rec))
        retornar
    }

    seja r = registrar_venda(_venda.itens, forma, rec, _venda.desconto, _op[0].nome, "")

    se (r.sucesso) {
        seja cupom = gerar_cupom(r.venda_id, _venda.itens, r.total, forma, r.troco, _op[0].nome)
        Arquivo.escrever("cupom_" + texto(r.venda_id) + ".txt", cupom)
        gui.alerta("✅  VENDA FINALIZADA!

Número:  #" + texto(r.venda_id) +
            "
Total:    " + moeda(r.total) +
            "
Forma:    " + forma +
            (forma == "Dinheiro" ? "
Troco:    " + moeda(r.troco) : "") +
            "

Cupom salvo: cupom_" + texto(r.venda_id) + ".txt")
        gui.toast("Venda #" + texto(r.venda_id) + " — " + moeda(r.total), "sucesso", 4000)
        pdv_limpar_venda()
        lbl_status_dir.configure(text="● Venda #" + texto(r.venda_id), fg="#22C55E")
        status_mensagem("  ✅  Venda #" + texto(r.venda_id) + " — " + moeda(r.total) + " — " + forma)
    } senão {
        gui.aviso("Erro ao registrar venda:
" + r.erro)
    }
}

funcao pdv_cancelar_ultima() {
    se (nao gui.confirmar("Cancelar a última venda?
O estoque será restaurado automaticamente.")) { retornar }
    seja ul = banco.sql("SELECT id,total_venda FROM vendas WHERE cancelada=FALSE ORDER BY id DESC LIMIT 1")
    se (ul.tamanho == 0) { gui.aviso("Nenhuma venda para cancelar!"); retornar }
    cancelar_venda(ul[0].id)
    gui.toast("Venda #" + texto(ul[0].id) + " cancelada — estoque restaurado", "aviso", 4000)
    status_mensagem("  ❌  Venda #" + texto(ul[0].id) + " cancelada")
}

funcao pdv_relatorio() {
    seja hoje = data_hoje(); seja p = hoje.dividir("/")
    seja ds = p[2] + "-" + p[1] + "-" + p[0]
    seja dados = relatorio_dia(ds); seja saldo = saldo_caixa(ds)
    txt_cx.configure(estado="habilitado"); txt_cx.delete("1.0","end")
    seja t = "═══════════════════════════════════
"
    t = t + "  RELATÓRIO DE CAIXA — " + hoje + "
"
    t = t + "═══════════════════════════════════

"
    se (dados.tamanho == 0) {
        t = t + "  Nenhuma venda registrada hoje.
"
    } senão {
        para (row em dados) {
            t = t + "  ▸ " + texto(row.forma_pagamento) + "
"
            t = t + "    Vendas:  " + texto(row.total_vendas) + "
"
            t = t + "    Fat.:    " + moeda(numero(row.faturamento)) + "
"
            t = t + "    Ticket:  " + moeda(numero(row.ticket_medio)) + "

"
        }
        t = t + "───────────────────────────────────
"
        t = t + "  Vendas:       " + moeda(saldo.vendas) + "
"
        t = t + "  Suprimentos:  " + moeda(saldo.entradas) + "
"
        t = t + "  Sangrias:     " + moeda(saldo.saidas) + "
"
        t = t + "  ─────────────────────────────
"
        t = t + "  SALDO FINAL:  " + moeda(saldo.saldo) + "
"
    }
    txt_cx.insert("1.0", t)
    txt_cx.configure(estado="desabilitado")
}

funcao pdv_top() {
    seja hoje = data_hoje(); seja p = hoje.dividir("/")
    seja ds = p[2] + "-" + p[1] + "-" + p[0]
    seja dados = top_produtos(ds)
    tbl_top.limpar()
    para (row em dados) {
        tbl_top.adicionar([texto(row.nome).primeiros(26),
            texto(arred(numero(row.qtd), 1)), moeda(numero(row.receita))])
    }
}

funcao pdv_estoque_baixo() {
    seja prods = estoque_baixo()
    tbl_es.limpar()
    para (p em prods) {
        tbl_es.adicionar([texto(p.nome).primeiros(24),
            texto(p.estoque_atual), texto(p.estoque_minimo), texto(p.cat)])
    }
    se (prods.tamanho > 0) {
        gui.toast("⚠️  " + texto(prods.tamanho) + " produto(s) com estoque baixo!", "aviso", 4000)
        lbl_status_dir.configure(text="⚠ " + texto(prods.tamanho) + " sem estoque", fg="#F59E0B")
    } senão {
        lbl_status_dir.configure(text="● Estoque OK", fg="#22C55E")
    }
}

funcao pdv_sangria() {
    seja v = gui.pedir("💰  Sangria de Caixa

Valor (R$):")
    se (v == nulo) { retornar }
    seja val = numero(v)
    se (val <= 0) { gui.aviso("Valor inválido!"); retornar }
    banco.sql("INSERT INTO movimentos_caixa (tipo,valor,operador,obs) VALUES ('sangria',$1,$2,'Sangria')",
        [val, _op[0].nome])
    gui.toast("Sangria de " + moeda(val) + " registrada", "aviso", 3000)
}

funcao pdv_suprimento() {
    seja v = gui.pedir("💵  Suprimento de Caixa

Valor (R$):")
    se (v == nulo) { retornar }
    seja val = numero(v)
    se (val <= 0) { gui.aviso("Valor inválido!"); retornar }
    banco.sql("INSERT INTO movimentos_caixa (tipo,valor,operador,obs) VALUES ('suprimento',$1,$2,'Suprimento')",
        [val, _op[0].nome])
    gui.toast("Suprimento de " + moeda(val) + " registrado", "sucesso", 3000)
}

funcao pdv_login() {
    seja login = gui.pedir("🔐  Login:"); se (login == nulo) { retornar }
    seja senha = gui.pedir("🔐  Senha:"); se (senha == nulo) { retornar }
    seja op = autenticar(login, senha)
    se (op != nulo) {
        _op[0] = op
        lbl_op.configure(text="  👤  " + op.nome + " (" + op.nivel + ")", fg="#22C55E")
        gui.toast("Bem-vindo, " + op.nome + "! 👋", "sucesso", 3000)
        status_mensagem("  ✅  Logado: " + op.nome + " | F10=Gestão  F12=Finalizar")
    } senão {
        gui.aviso("⛔  Login ou senha incorretos!")
    }
}

// SEÇÃO 6 — JANELA DE GESTÃO (CADASTRO COMPLETO)
// ═══════════════════════════════════════════════════════════════════════════

funcao abrir_gestao() {
    seja jg = gui.janela("⚙️ Gestão — Produtos, Estoque e Operadores", 1000, 680)

    seja abas_g = gui.abas(jg)

    // ════════════════════════════════════════════════════════════════════
    // ABA PRODUTOS — CRUD COMPLETO
    // ════════════════════════════════════════════════════════════════════
    seja tab_p = abas_g.adicionar("📦 Produtos")

    seja f_p_top = gui.frame_horizontal(tab_p)
    seja c_p_filtro = gui.campo(f_p_top, placeholder="Buscar por nome ou código...", largura=28)
    c_p_filtro.pack(lado="esquerda", espaco_x=6, espaco_y=6)

    seja cats_lista = banco.sql("SELECT nome FROM categorias ORDER BY nome")
    seja cats_nomes = ["Todas"] + cats_lista.mapear((c) => texto(c.nome))
    seja sel_cat = gui.caixa_selecao(f_p_top, opcoes=cats_nomes, valor_inicial="Todas")
    sel_cat.pack(lado="esquerda", espaco_x=4)

    gui.botao(f_p_top, "🔍 Filtrar",
        ao_clicar=() => prod_listar(),
        estilo="primario").pack(lado="esquerda", espaco_x=4)
    gui.botao(f_p_top, "➕ Novo Produto",
        ao_clicar=() => prod_novo(),
        estilo="sucesso").pack(lado="direita", espaco_x=8)

    seja tbl_p = gui.tabela(tab_p,
        colunas=["ID","Código","Nome","Preço","Custo","Estoque","Min.","Un.","Cat.","Ativo"],
        altura=16,
        ao_selecionar=(l) => prod_selecionar(l))

    seja f_p_bot = gui.frame_horizontal(tab_p)
    gui.botao(f_p_bot, "✏️ Editar",        ao_clicar=() => prod_editar(),   estilo="primario").pack(lado="esquerda",espaco_x=4,espaco_y=4)
    gui.botao(f_p_bot, "🗑️ Excluir",       ao_clicar=() => prod_excluir(),  estilo="perigo").pack(lado="esquerda",espaco_x=2)
    gui.botao(f_p_bot, "📦 Ajustar Estoque",ao_clicar=()=>prod_ajuste_est(),estilo="aviso").pack(lado="esquerda",espaco_x=2)
    gui.botao(f_p_bot, "🔄 Atualizar",     ao_clicar=() => prod_listar(),   estilo="secundario").pack(lado="direita",espaco_x=8)

    seja _prod_sel = [nulo]

    funcao prod_listar() {
        seja filtro = c_p_filtro.get()
        seja cat = sel_cat.get()
        seja prods = listar_produtos(filtro, cat, falso)
        tbl_p.limpar()
        para (p em prods) {
            tbl_p.adicionar([
                texto(p.id), texto(p.codigo_barras), texto(p.nome).primeiros(28),
                moeda(numero(p.preco_venda)), moeda(numero(p.preco_custo)),
                texto(p.estoque_atual), texto(p.estoque_minimo),
                texto(p.unidade), texto(p.categoria_nome ?? ""),
                p.ativo ? "✅" : "❌"
            ])
        }
        status_mensagem("  " + texto(prods.tamanho) + " produto(s)")
    }

    funcao prod_selecionar(linha) {
        _prod_sel[0] = linha
    }

    funcao abrir_form_produto(titulo, dados_init) {
        seja jf = gui.janela(titulo, 520, 540)

        seja f_form = gui.frame(jf, cor="#1E293B")
        f_form.pack(preencher="ambos", expandir=verdadeiro, espaco_x=16, espaco_y=12)

        // Campos do formulário
        funcao campo_form(pai, rotulo, valor_init, larg) {
            gui.label(pai, rotulo, tamanho=9, cor="#94A3B8")
            seja c = gui.campo(pai, largura=larg)
            se (valor_init != nulo e valor_init != "") { c.insert(0, texto(valor_init)) }
            retornar c
        }

        gui.label(f_form, "Código de Barras:", tamanho=9, cor="#94A3B8")
        seja c_cod_f  = gui.campo(f_form, largura=40)
        se (dados_init.codigo_barras != nulo) { c_cod_f.insert(0, texto(dados_init.codigo_barras)) }

        gui.label(f_form, "Nome do Produto:", tamanho=9, cor="#94A3B8")
        seja c_nome_f = gui.campo(f_form, largura=40)
        se (dados_init.nome != nulo) { c_nome_f.insert(0, texto(dados_init.nome)) }

        gui.label(f_form, "Descrição:", tamanho=9, cor="#94A3B8")
        seja c_desc_f = gui.area_texto(f_form, largura=40, altura=2)
        se (dados_init.descricao != nulo e dados_init.descricao != "") {
            c_desc_f.insert("1.0", texto(dados_init.descricao))
        }

        seja f_r1 = gui.frame_horizontal(f_form)
        gui.label(f_r1, "Preço Venda: R$", tamanho=9, cor="#94A3B8").pack(lado="esquerda")
        seja c_pv = gui.campo(f_r1, largura=10)
        se (dados_init.preco_venda != nulo) { c_pv.insert(0, texto(dados_init.preco_venda)) }
        c_pv.pack(lado="esquerda", espaco_x=4)
        gui.label(f_r1, "  Custo: R$", tamanho=9, cor="#94A3B8").pack(lado="esquerda")
        seja c_pc = gui.campo(f_r1, largura=10)
        se (dados_init.preco_custo != nulo) { c_pc.insert(0, texto(dados_init.preco_custo)) }
        c_pc.pack(lado="esquerda", espaco_x=4)

        seja f_r2 = gui.frame_horizontal(f_form)
        gui.label(f_r2, "Estoque Atual:", tamanho=9, cor="#94A3B8").pack(lado="esquerda")
        seja c_est = gui.campo(f_r2, largura=8)
        se (dados_init.estoque_atual != nulo) { c_est.insert(0, texto(dados_init.estoque_atual)) }
        c_est.pack(lado="esquerda", espaco_x=4)
        gui.label(f_r2, "  Mínimo:", tamanho=9, cor="#94A3B8").pack(lado="esquerda")
        seja c_min = gui.campo(f_r2, largura=8)
        se (dados_init.estoque_minimo != nulo) { c_min.insert(0, texto(dados_init.estoque_minimo)) }
        c_min.pack(lado="esquerda", espaco_x=4)
        gui.label(f_r2, "  Un.:", tamanho=9, cor="#94A3B8").pack(lado="esquerda")
        seja c_un = gui.caixa_selecao(f_r2,
            opcoes=["un","kg","L","cx","pc","dz"],
            valor_inicial=dados_init.unidade ?? "un")
        c_un.pack(lado="esquerda", espaco_x=4)

        gui.label(f_form, "Categoria:", tamanho=9, cor="#94A3B8")
        seja c_cat_f = gui.caixa_selecao(f_form,
            opcoes=cats_nomes.filtrar((c) => c != "Todas"),
            valor_inicial=dados_init.categoria_nome ?? "Mercearia")

        gui.separador(f_form)

        seja f_btns = gui.frame_horizontal(f_form)
        gui.botao(f_btns, "💾 Salvar",
            ao_clicar=() => {
                seja dados = {
                    id:            dados_init.id,
                    codigo_barras: c_cod_f.get().aparar(),
                    nome:          c_nome_f.get().aparar(),
                    descricao:     c_desc_f.get("1.0","end").aparar(),
                    preco_venda:   numero(c_pv.get()),
                    preco_custo:   numero(c_pc.get()),
                    estoque_atual: numero(c_est.get()),
                    estoque_minimo:numero(c_min.get()),
                    unidade:       c_un.get(),
                    categoria:     c_cat_f.get()
                }
                se (dados.codigo_barras == "") { gui.aviso("Código de barras obrigatório!"); retornar }
                se (dados.nome == "") { gui.aviso("Nome obrigatório!"); retornar }
                se (dados.preco_venda <= 0) { gui.aviso("Preço deve ser maior que zero!"); retornar }
                tentar {
                    seja r = salvar_produto(dados)
                    gui.toast("Produto " + r.acao + " com sucesso!", "sucesso", 3000)
                    prod_listar()
                    gui.apos(50, () => jf.destroy())
                } pegar (e) {
                    gui.aviso("Erro ao salvar:\n" + texto(e))
                }
            }, estilo="sucesso").pack(lado="esquerda", espaco_x=4, espaco_y=6)

        gui.botao(f_btns, "❌ Cancelar",
            ao_clicar=() => gui.apos(50, () => jf.destroy()),
            estilo="perigo").pack(lado="esquerda", espaco_x=4)
    }

    funcao prod_novo() {
        abrir_form_produto("➕ Novo Produto", {id: nulo, codigo_barras: "",
            nome: "", descricao: "", preco_venda: 0, preco_custo: 0,
            estoque_atual: 0, estoque_minimo: 5, unidade: "un",
            categoria_nome: "Mercearia"})
    }

    funcao prod_editar() {
        se (_prod_sel[0] == nulo) { gui.aviso("Selecione um produto!"); retornar }
        seja id = inteiro(_prod_sel[0]["ID"])
        seja r = banco.sql(`SELECT p.*,c.nome as categoria_nome
            FROM produtos p LEFT JOIN categorias c ON c.id=p.categoria_id
            WHERE p.id=$1`, [id])
        se (r.tamanho == 0) { gui.aviso("Produto não encontrado!"); retornar }
        abrir_form_produto("✏️ Editar Produto — " + texto(r[0].nome), r[0])
    }

    funcao prod_excluir() {
        se (_prod_sel[0] == nulo) { gui.aviso("Selecione um produto!"); retornar }
        seja nm = _prod_sel[0]["Nome"]
        se (nao gui.confirmar("Excluir/Desativar o produto:\n" + nm + "?")) { retornar }
        seja id = inteiro(_prod_sel[0]["ID"])
        seja r = excluir_produto(id)
        se (r.tipo == "desativado") {
            gui.toast(nm + " desativado (tem vendas vinculadas)", "aviso", 4000)
        } senão {
            gui.toast(nm + " excluído!", "sucesso", 3000)
        }
        prod_listar()
    }

    funcao prod_ajuste_est() {
        se (_prod_sel[0] == nulo) { gui.aviso("Selecione um produto!"); retornar }
        seja nm  = _prod_sel[0]["Nome"]
        seja id  = inteiro(_prod_sel[0]["ID"])
        seja est = _prod_sel[0]["Estoque"]

        seja tipo_str = gui.pedir("Tipo de ajuste:\n1 = Entrada\n2 = Saída/Perda\nDigite 1 ou 2:")
        se (tipo_str == nulo) { retornar }
        seja tipo_mov = tipo_str == "1" ? "entrada" : "saida"

        seja qtd_str = gui.pedir("Quantidade a " + (tipo_mov=="entrada"?"ADICIONAR":"REMOVER") + ":\n(Estoque atual: " + texto(est) + ")")
        se (qtd_str == nulo) { retornar }
        seja qtd = numero(qtd_str)
        se (qtd <= 0) { gui.aviso("Quantidade inválida!"); retornar }

        seja obs = gui.pedir("Motivo (opcional):") ?? ""

        ajustar_estoque(id, qtd, tipo_mov, obs, _op[0].nome)
        gui.toast("Estoque de " + nm + " " + (tipo_mov=="entrada"?"aumentado":"reduzido") + " em " + texto(qtd), "sucesso", 3000)
        prod_listar()
    }

    prod_listar()

    // ════════════════════════════════════════════════════════════════════
    // ABA OPERADORES
    // ════════════════════════════════════════════════════════════════════
    seja tab_op = abas_g.adicionar("👤 Operadores")

    gui.botao(tab_op, "➕ Novo Operador",
        ao_clicar=() => op_novo(),
        estilo="sucesso").pack(ancora="leste", espaco_x=8, espaco_y=6)

    seja tbl_op = gui.tabela(tab_op,
        colunas=["ID","Nome","Login","Nível","Ativo"],
        altura=14,
        ao_selecionar=(l) => op_selecionar(l))

    seja f_op_bot = gui.frame_horizontal(tab_op)
    gui.botao(f_op_bot,"✏️ Editar",   ao_clicar=()=>op_editar(),  estilo="primario").pack(lado="esquerda",espaco_x=4,espaco_y=4)
    gui.botao(f_op_bot,"🔐 Alterar Senha",ao_clicar=()=>op_alterar_senha(),estilo="aviso").pack(lado="esquerda",espaco_x=2)
    gui.botao(f_op_bot,"🗑️ Desativar",ao_clicar=()=>op_excluir(), estilo="perigo").pack(lado="esquerda",espaco_x=2)
    gui.botao(f_op_bot,"🔄 Atualizar",ao_clicar=()=>op_listar(),  estilo="secundario").pack(lado="direita",espaco_x=8)

    seja _op_sel = [nulo]

    funcao op_listar() {
        seja ops = listar_operadores()
        tbl_op.limpar()
        para (o em ops) {
            tbl_op.adicionar([texto(o.id), texto(o.nome), texto(o.login),
                texto(o.nivel), o.ativo ? "✅" : "❌"])
        }
    }

    funcao op_selecionar(linha) { _op_sel[0] = linha }

    funcao op_form(titulo, dados) {
        seja jop = gui.janela(titulo, 420, 340)
        seja ff = gui.frame(jop, cor="#1E293B")
        ff.pack(preencher="ambos", expandir=verdadeiro, espaco_x=16, espaco_y=12)

        gui.label(ff, "Nome:", tamanho=9, cor="#94A3B8")
        seja c_nm = gui.campo(ff, largura=36)
        se (dados.nome != nulo) { c_nm.insert(0, texto(dados.nome)) }

        gui.label(ff, "Login:", tamanho=9, cor="#94A3B8")
        seja c_lg = gui.campo(ff, largura=20)
        se (dados.login != nulo) { c_lg.insert(0, texto(dados.login)) }

        gui.label(ff, "Senha" + (dados.id != nulo ? " (deixe em branco para não alterar):" : ":"), tamanho=9, cor="#94A3B8")
        seja c_sn = gui.campo(ff, largura=20)

        gui.label(ff, "Nível:", tamanho=9, cor="#94A3B8")
        seja c_nv = gui.caixa_selecao(ff, opcoes=["caixa","gerente","admin"],
            valor_inicial=dados.nivel ?? "caixa")

        gui.separador(ff)
        seja f_bb = gui.frame_horizontal(ff)
        gui.botao(f_bb, "💾 Salvar",
            ao_clicar=() => {
                seja d = {id: dados.id, nome: c_nm.get().aparar(),
                    login: c_lg.get().aparar(), senha: c_sn.get(),
                    nivel: c_nv.get(), ativo: verdadeiro}
                se (d.nome == "") { gui.aviso("Nome obrigatório!"); retornar }
                se (d.login == "") { gui.aviso("Login obrigatório!"); retornar }
                se (d.id == nulo e d.senha == "") { gui.aviso("Senha obrigatória para novo operador!"); retornar }
                salvar_operador(d)
                gui.toast("Operador salvo!", "sucesso", 3000)
                op_listar()
                gui.apos(50, () => jop.destroy())
            }, estilo="sucesso").pack(lado="esquerda",espaco_x=4,espaco_y=6)
        gui.botao(f_bb, "❌ Cancelar", ao_clicar=()=>gui.apos(50, () => jop.destroy()), estilo="perigo").pack(lado="esquerda",espaco_x=4)
    }

    funcao op_novo() {
        op_form("➕ Novo Operador", {id: nulo, nome: "", login: "", senha: "", nivel: "caixa"})
    }

    funcao op_editar() {
        se (_op_sel[0] == nulo) { gui.aviso("Selecione um operador!"); retornar }
        seja id = inteiro(_op_sel[0]["ID"])
        seja r = banco.sql("SELECT * FROM operadores WHERE id=$1", [id])
        se (r.tamanho > 0) { op_form("✏️ Editar Operador", r[0]) }
    }

    funcao op_alterar_senha() {
        se (_op_sel[0] == nulo) { gui.aviso("Selecione um operador!"); retornar }
        seja id = inteiro(_op_sel[0]["ID"])
        seja nm = _op_sel[0]["Nome"]
        seja nova = gui.pedir("Nova senha para " + nm + ":")
        se (nova == nulo ou nova == "") { retornar }
        banco.sql("UPDATE operadores SET senha=$1 WHERE id=$2", [nova, id])
        gui.toast("Senha alterada para " + nm, "sucesso", 3000)
    }

    funcao op_excluir() {
        se (_op_sel[0] == nulo) { gui.aviso("Selecione um operador!"); retornar }
        seja nm = _op_sel[0]["Nome"]
        se (nao gui.confirmar("Desativar operador: " + nm + "?")) { retornar }
        seja id = inteiro(_op_sel[0]["ID"])
        excluir_operador(id)
        gui.toast(nm + " desativado", "aviso", 3000)
        op_listar()
    }

    op_listar()

    // ════════════════════════════════════════════════════════════════════
    // ABA CATEGORIAS
    // ════════════════════════════════════════════════════════════════════
    seja tab_c = abas_g.adicionar("🏷️ Categorias")

    gui.label(tab_c, "  Categorias de Produtos:", negrito=verdadeiro,
        tamanho=11, cor="#F1F5F9").pack(ancora="oeste", espaco_x=10, espaco_y=8)

    seja f_nc = gui.frame_horizontal(tab_c)
    seja c_nova_cat = gui.campo(f_nc, placeholder="Nome da nova categoria...", largura=30)
    c_nova_cat.pack(lado="esquerda", espaco_x=8)
    gui.botao(f_nc, "➕ Adicionar",
        ao_clicar=() => {
            seja nm = c_nova_cat.get().aparar()
            se (nm == "") { gui.aviso("Digite o nome!"); retornar }
            tentar {
                banco.sql("INSERT INTO categorias (nome) VALUES ($1)", [nm])
                c_nova_cat.delete(0,"end")
                cat_listar()
                gui.toast("Categoria '" + nm + "' criada!", "sucesso", 3000)
            } pegar (e) {
                gui.aviso("Categoria já existe!")
            }
        }, estilo="sucesso").pack(lado="esquerda", espaco_x=4)

    seja tbl_cat = gui.tabela(tab_c,
        colunas=["ID","Nome","Nº Produtos"],
        altura=14)

    gui.botao(tab_c, "🗑️ Excluir Categoria Selecionada",
        ao_clicar=() => {
            seja sel = tbl_cat.selecionado()
            se (sel == nulo) { gui.aviso("Selecione uma categoria!"); retornar }
            seja id = inteiro(sel["ID"])
            seja nm = sel["Nome"]
            seja nprod = inteiro(sel["Nº Produtos"])
            se (nprod > 0) {
                gui.aviso("Não é possível excluir!\n" + nm + " tem " + texto(nprod) + " produto(s).")
                retornar
            }
            se (gui.confirmar("Excluir categoria: " + nm + "?")) {
                banco.sql("DELETE FROM categorias WHERE id=$1", [id])
                cat_listar()
                gui.toast("Categoria excluída!", "sucesso", 3000)
            }
        }, estilo="perigo").pack(espaco_x=8, espaco_y=4)

    funcao cat_listar() {
        seja cats = banco.sql(`
            SELECT c.id, c.nome,
                COUNT(p.id) AS nprod
            FROM categorias c
            LEFT JOIN produtos p ON p.categoria_id=c.id AND p.ativo=TRUE
            GROUP BY c.id, c.nome ORDER BY c.nome`)
        tbl_cat.limpar()
        para (c em cats) {
            tbl_cat.adicionar([texto(c.id), texto(c.nome), texto(c.nprod)])
        }
    }

    cat_listar()

}

// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// SEÇÃO 7 — ATALHOS E INICIALIZAÇÃO
// ═══════════════════════════════════════════════════════════════════════════

jan.bind("<Return>", (e) => pdv_adicionar())
jan.bind("<F12>",    (e) => pdv_finalizar())
jan.bind("<Escape>", (e) => pdv_limpar_venda())
jan.bind("<F5>",     (e) => pdv_relatorio())
jan.bind("<F6>",     (e) => pdv_estoque_baixo())
jan.bind("<F7>",     (e) => pdv_top())
jan.bind("<F8>",     (e) => pdv_login())
jan.bind("<F9>",     (e) => pdv_cancelar_ultima())
jan.bind("<F10>",    (e) => abrir_gestao())

tentar {
    setup_banco()
    _op[0] = {id: 1, nome: "Administrador", nivel: "gerente"}
    lbl_op.configure(text="  👤  Administrador (gerente)", fg="#22C55E")
    lbl_status_dir.configure(text="● Conectado", fg="#22C55E")
    pdv_estoque_baixo()
    status_mensagem(
        "  ⌨  Enter=Adicionar  F8=Login  F9=Cancelar  F10=Gestão  F12=Finalizar")
} pegar (e) {
    lbl_status_dir.configure(text="● Sem banco", fg="#EF4444")
    gui.aviso("Erro ao conectar ao banco:\n" + texto(e) +
        "\n\nConfigure o .env:\nADVAK_DB_HOST, ADVAK_DB_PORT, ADVAK_DB_USER, ADVAK_DB_PASS, ADVAK_DB_NAME=supermercado")
    status_mensagem("  ❌  Sem conexão — configure o .env")
}

gui.iniciar()
