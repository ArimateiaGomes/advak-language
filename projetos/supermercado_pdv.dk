funcao criar_metrica(pai, rotulo, valor_init, cor_val) {
    seja f = gui.frame(pai, cor="#0D1B2E")
    f.configure(height=58, width=130)
    f.pack(lado="esquerda", espaco_x=5, espaco_y=4)
    f.pack_propagate(falso)
    gui.label(f, rotulo, tamanho=7, cor="#4B6B8A", negrito=verdadeiro).pack(ancora="oeste", espaco_x=8, espaco_y=3)
    seja lv = gui.label(f, valor_init, tamanho=12, cor=cor_val, negrito=verdadeiro)
    lv.pack(ancora="oeste", espaco_x=8)
    retornar lv
}

