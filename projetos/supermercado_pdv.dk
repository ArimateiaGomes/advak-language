// SEÇÃO 3 — ESTADO
// ═══════════════════════════════════════════════════════════════════════════

seja _op      = [{id: nulo, nome: "Não logado", nivel: "caixa"}]
seja _venda   = {itens: [], desconto: 0.0}
seja _edit_id = [nulo]  // produto sendo editado

funcao total_bruto() {
    retornar _venda.itens.reduzir((a,i) => a+i.subtotal, 0)
}
funcao total_liq() {
    retornar arred(total_bruto() - _venda.desconto, 2)
}

