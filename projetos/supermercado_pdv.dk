// ═══════════════════════════════════════════════════════════════════════════
//  ADVAK 5.0 — PDV Supermercado COMPLETO
//  Cadastro, edição, exclusão, estoque, vendas, relatórios
//
//  .env: ADVAK_DB_HOST / PORT / USER / PASS / NAME=supermercado
//  Execute: advak projetos\supermercado_pdv.dk --db
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// SEÇÃO 1 — SETUP DO BANCO
// ═══════════════════════════════════════════════════════════════════════════

funcao setup_banco() {
    banco.sql(`CREATE TABLE IF NOT EXISTS operadores (
        id SERIAL PRIMARY KEY, nome VARCHAR(50) NOT NULL,
        login VARCHAR(20) UNIQUE NOT NULL, senha VARCHAR(64) NOT NULL,
        nivel VARCHAR(10) DEFAULT 'caixa', ativo BOOLEAN DEFAULT TRUE
    )`)
    banco.sql(`CREATE TABLE IF NOT EXISTS categorias (
        id SERIAL PRIMARY KEY, nome VARCHAR(50) UNIQUE NOT NULL
    )`)
    banco.sql(`CREATE TABLE IF NOT EXISTS produtos (
        id SERIAL PRIMARY KEY, codigo_barras VARCHAR(13) UNIQUE NOT NULL,
        nome VARCHAR(100) NOT NULL, descricao TEXT DEFAULT '',
        preco_venda DECIMAL(10,2) NOT NULL, preco_custo DECIMAL(10,2) DEFAULT 0,
        estoque_atual DECIMAL(10,3) DEFAULT 0, estoque_minimo DECIMAL(10,3) DEFAULT 5,
        unidade VARCHAR(10) DEFAULT 'un', categoria_id INT REFERENCES categorias(id),
        ativo BOOLEAN DEFAULT TRUE, criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )`)
    banco.sql(`CREATE TABLE IF NOT EXISTS vendas (
        id SERIAL PRIMARY KEY, data_hora TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        total_bruto DECIMAL(10,2) NOT NULL DEFAULT 0,
        desconto DECIMAL(10,2) NOT NULL DEFAULT 0,
        total_venda DECIMAL(10,2) NOT NULL,
        forma_pagamento VARCHAR(20) NOT NULL,
        valor_recebido DECIMAL(10,2), troco DECIMAL(10,2) DEFAULT 0,
        operador VARCHAR(50), cancelada BOOLEAN DEFAULT FALSE, obs TEXT
    )`)
    banco.sql(`CREATE TABLE IF NOT EXISTS itens_venda (
        id SERIAL PRIMARY KEY, venda_id INT REFERENCES vendas(id) ON DELETE CASCADE,
        produto_id INT REFERENCES produtos(id), nome_produto VARCHAR(100) NOT NULL,
        quantidade DECIMAL(10,3) NOT NULL, preco_unitario DECIMAL(10,2) NOT NULL,
        desconto_item DECIMAL(10,2) DEFAULT 0, subtotal DECIMAL(10,2) NOT NULL
    )`)
    banco.sql(`CREATE TABLE IF NOT EXISTS movimentos_estoque (
        id SERIAL PRIMARY KEY, produto_id INT REFERENCES produtos(id),
        data_hora TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        tipo VARCHAR(20) NOT NULL, quantidade DECIMAL(10,3) NOT NULL,
        obs TEXT, operador VARCHAR(50)
    )`)
    banco.sql(`CREATE TABLE IF NOT EXISTS movimentos_caixa (
        id SERIAL PRIMARY KEY, data_hora TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        tipo VARCHAR(20) NOT NULL, valor DECIMAL(10,2) NOT NULL,
        operador VARCHAR(50), obs TEXT
    )`)
    banco.sql(`CREATE INDEX IF NOT EXISTS idx_codbar ON produtos(codigo_barras)`)
    banco.sql(`CREATE INDEX IF NOT EXISTS idx_vendas_data ON vendas(data_hora)`)

    // Trigger baixar estoque
    banco.sql(`CREATE OR REPLACE FUNCTION baixar_estoque() RETURNS TRIGGER AS $$
        BEGIN UPDATE produtos SET estoque_atual = estoque_atual - NEW.quantidade,
            atualizado_em = NOW() WHERE id = NEW.produto_id; RETURN NEW; END;
        $$ LANGUAGE plpgsql`)
    banco.sql(`DROP TRIGGER IF EXISTS trg_venda_estoque ON itens_venda`)
    banco.sql(`CREATE TRIGGER trg_venda_estoque AFTER INSERT ON itens_venda
        FOR EACH ROW EXECUTE FUNCTION baixar_estoque()`)

    // Trigger restaurar estoque ao cancelar
    banco.sql(`CREATE OR REPLACE FUNCTION restaurar_estoque_cancelamento()
        RETURNS TRIGGER AS $$
        BEGIN IF NEW.cancelada = TRUE AND OLD.cancelada = FALSE THEN
            UPDATE produtos p SET estoque_atual = estoque_atual + iv.quantidade,
                atualizado_em = NOW()
            FROM itens_venda iv WHERE iv.venda_id = NEW.id AND p.id = iv.produto_id;
        END IF; RETURN NEW; END; $$ LANGUAGE plpgsql`)
    banco.sql(`DROP TRIGGER IF EXISTS trg_cancelar_venda ON vendas`)
    banco.sql(`CREATE TRIGGER trg_cancelar_venda AFTER UPDATE ON vendas
        FOR EACH ROW EXECUTE FUNCTION restaurar_estoque_cancelamento()`)

    // Dados iniciais
    banco.sql(`INSERT INTO categorias (nome) VALUES
        ('Grãos'),('Óleos'),('Mercearia'),('Massas'),('Temperos'),
        ('Laticínios'),('Bebidas'),('Biscoitos'),('Limpeza'),('Higiene'),('Frios')
        ON CONFLICT (nome) DO NOTHING`)
    banco.sql(`INSERT INTO operadores (nome,login,senha,nivel) VALUES
        ('Administrador','admin','admin123','gerente'),
        ('Caixa 01','caixa1','1234','caixa')
        ON CONFLICT (login) DO NOTHING`)
    banco.sql(`INSERT INTO produtos (codigo_barras,nome,preco_venda,preco_custo,estoque_atual,estoque_minimo,unidade,categoria_id) VALUES
        ('7891000100103','Arroz Tipo 1 5kg',    8.90,5.50,50,10,'un', (SELECT id FROM categorias WHERE nome='Grãos')),
        ('7891000053508','Feijão Carioca 1kg',   5.50,3.20,40,10,'un', (SELECT id FROM categorias WHERE nome='Grãos')),
        ('7891910000197','Óleo de Soja 900ml',   7.20,4.80,30,5, 'un', (SELECT id FROM categorias WHERE nome='Óleos')),
        ('7896005800027','Açúcar Cristal 1kg',   4.80,2.90,60,10,'un', (SELECT id FROM categorias WHERE nome='Mercearia')),
        ('7891024130132','Macarrão Espaguete 500g',3.50,2.10,45,10,'un',(SELECT id FROM categorias WHERE nome='Massas')),
        ('7891149410116','Sal Refinado 1kg',     2.30,1.20,80,15,'un', (SELECT id FROM categorias WHERE nome='Temperos')),
        ('7891515501012','Leite Integral 1L',    4.50,3.00,35,10,'un', (SELECT id FROM categorias WHERE nome='Laticínios')),
        ('7896065200059','Café Torrado 500g',   12.90,8.50,25,5, 'un', (SELECT id FROM categorias WHERE nome='Bebidas')),
        ('7894900011517','Coca-Cola 2L',         9.80,6.50,20,5, 'un', (SELECT id FROM categorias WHERE nome='Bebidas')),
        ('7891000060507','Biscoito Maizena 400g',4.20,2.80,38,8, 'un', (SELECT id FROM categorias WHERE nome='Biscoitos')),
        ('7891962031003','Sabão em Pó 1kg',      8.90,6.00,22,5, 'un', (SELECT id FROM categorias WHERE nome='Limpeza')),
        ('7896004803090','Detergente 500ml',     2.50,1.50,45,10,'un', (SELECT id FROM categorias WHERE nome='Limpeza')),
        ('7891107101621','Shampoo 400ml',       12.50,8.00,18,5, 'un', (SELECT id FROM categorias WHERE nome='Higiene')),
        ('7891152402285','Papel Higiênico 4un',  6.90,4.50,30,8, 'un', (SELECT id FROM categorias WHERE nome='Higiene')),
        ('7893000615811','Queijo Minas 500g',   18.90,12.00,15,3,'kg', (SELECT id FROM categorias WHERE nome='Frios'))
        ON CONFLICT (codigo_barras) DO NOTHING`)
}

// ═══════════════════════════════════════════════════════════════════════════
// SEÇÃO 2 — FUNÇÕES DE BANCO (CRUD COMPLETO)
// ═══════════════════════════════════════════════════════════════════════════

// ── Produtos ─────────────────────────────────────────────────────────────

funcao listar_produtos(filtro, categoria, so_ativos) {
    seja where = "WHERE 1=1"
    seja params = []
    seja idx = [1]

    se (so_ativos) { where = where + " AND p.ativo=TRUE" }

    se (filtro != nulo e filtro.aparar() != "") {
        seja e_cod = Regex.testar("^[0-9]+$", filtro.aparar())
        se (e_cod) {
            where = where + " AND p.codigo_barras ILIKE $" + texto(idx[0])
            params.adicionar("%" + filtro + "%")
        } senão {
            where = where + " AND p.nome ILIKE $" + texto(idx[0])
            params.adicionar("%" + filtro + "%")
        }
        idx[0]++
    }

    se (categoria != nulo e categoria != "" e categoria != "Todas") {
        where = where + " AND c.nome=$" + texto(idx[0])
        params.adicionar(categoria)
        idx[0]++
    }

    retornar banco.sql(`
        SELECT p.*, c.nome as categoria_nome
        FROM produtos p
        LEFT JOIN categorias c ON c.id=p.categoria_id
        ` + where + ` ORDER BY p.nome LIMIT 200`, params)
}

funcao buscar_por_codigo_ou_nome(termo) {
    seja e_cod = Regex.testar("^[0-9]+$", termo.aparar())
    se (e_cod) {
        seja r = banco.sql(
            "SELECT p.*,c.nome as categoria_nome FROM produtos p LEFT JOIN categorias c ON c.id=p.categoria_id WHERE p.codigo_barras=$1 AND p.ativo=TRUE",
            [termo])
        retornar r
    }
    retornar banco.sql(
        "SELECT p.*,c.nome as categoria_nome FROM produtos p LEFT JOIN categorias c ON c.id=p.categoria_id WHERE p.nome ILIKE $1 AND p.ativo=TRUE ORDER BY p.nome LIMIT 20",
        ["%" + termo + "%"])
}

funcao salvar_produto(dados) {
    // Determina categoria_id
    seja cat_id = nulo
    se (dados.categoria != nulo e dados.categoria != "") {
        seja cr = banco.sql("SELECT id FROM categorias WHERE nome=$1", [dados.categoria])
        se (cr.tamanho > 0) { cat_id = cr[0].id }
    }

    se (dados.id == nulo) {
        // INSERT
        seja r = banco.sql(`
            INSERT INTO produtos
                (codigo_barras,nome,descricao,preco_venda,preco_custo,
                 estoque_atual,estoque_minimo,unidade,categoria_id)
            VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9) RETURNING id`,
            [dados.codigo_barras, dados.nome, dados.descricao ?? "",
             dados.preco_venda, dados.preco_custo ?? 0,
             dados.estoque_atual ?? 0, dados.estoque_minimo ?? 5,
             dados.unidade ?? "un", cat_id])
        retornar {sucesso: verdadeiro, id: r[0].id, acao: "criado"}
    } senão {
        // UPDATE
        banco.sql(`
            UPDATE produtos SET
                codigo_barras=$1, nome=$2, descricao=$3,
                preco_venda=$4, preco_custo=$5,
                estoque_atual=$6, estoque_minimo=$7,
                unidade=$8, categoria_id=$9,
                atualizado_em=NOW()
            WHERE id=$10`,
            [dados.codigo_barras, dados.nome, dados.descricao ?? "",
             dados.preco_venda, dados.preco_custo ?? 0,
             dados.estoque_atual, dados.estoque_minimo ?? 5,
             dados.unidade ?? "un", cat_id, dados.id])
        retornar {sucesso: verdadeiro, id: dados.id, acao: "atualizado"}
    }
}

funcao excluir_produto(id) {
    // Verificar se tem vendas
    seja r = banco.sql(
        "SELECT COUNT(*) cnt FROM itens_venda WHERE produto_id=$1", [id])
    se (numero(r[0].cnt) > 0) {
        // Soft delete — desativa ao invés de excluir
        banco.sql("UPDATE produtos SET ativo=FALSE, atualizado_em=NOW() WHERE id=$1", [id])
        retornar {sucesso: verdadeiro, tipo: "desativado"}
    }
    banco.sql("DELETE FROM produtos WHERE id=$1", [id])
    retornar {sucesso: verdadeiro, tipo: "excluido"}
}

funcao ajustar_estoque(produto_id, qtd, tipo, obs, operador) {
    se (tipo == "entrada") {
        banco.sql("UPDATE produtos SET estoque_atual=estoque_atual+$1, atualizado_em=NOW() WHERE id=$2",
            [qtd, produto_id])
    } senão {
        banco.sql("UPDATE produtos SET estoque_atual=estoque_atual-$1, atualizado_em=NOW() WHERE id=$2",
            [qtd, produto_id])
    }
    banco.sql("INSERT INTO movimentos_estoque (produto_id,tipo,quantidade,obs,operador) VALUES ($1,$2,$3,$4,$5)",
        [produto_id, tipo, qtd, obs, operador])
}

// ── Operadores ────────────────────────────────────────────────────────────

funcao listar_operadores() {
    retornar banco.sql("SELECT * FROM operadores ORDER BY nome")
}

funcao salvar_operador(dados) {
    se (dados.id == nulo) {
        banco.sql("INSERT INTO operadores (nome,login,senha,nivel,ativo) VALUES ($1,$2,$3,$4,$5)",
            [dados.nome, dados.login, dados.senha, dados.nivel ?? "caixa", verdadeiro])
    } senão {
        se (dados.senha != "" e dados.senha != nulo) {
            banco.sql("UPDATE operadores SET nome=$1,login=$2,senha=$3,nivel=$4,ativo=$5 WHERE id=$6",
                [dados.nome, dados.login, dados.senha, dados.nivel, dados.ativo, dados.id])
        } senão {
            banco.sql("UPDATE operadores SET nome=$1,login=$2,nivel=$3,ativo=$4 WHERE id=$5",
                [dados.nome, dados.login, dados.nivel, dados.ativo, dados.id])
        }
    }
    retornar {sucesso: verdadeiro}
}

funcao excluir_operador(id) {
    banco.sql("UPDATE operadores SET ativo=FALSE WHERE id=$1", [id])
    retornar {sucesso: verdadeiro}
}

funcao autenticar(login, senha) {
    seja r = banco.sql(
        "SELECT * FROM operadores WHERE login=$1 AND senha=$2 AND ativo=TRUE",
        [login, senha])
    retornar r.tamanho > 0 ? r[0] : nulo
}

// ── Vendas ────────────────────────────────────────────────────────────────

funcao registrar_venda(itens, forma_pag, valor_recebido, desconto, operador, obs) {
    seja total_bruto = itens.reduzir((a, i) => a + i.subtotal, 0)
    seja desc        = numero(desconto ?? 0)
    seja total       = arred(total_bruto - desc, 2)
    seja troco       = forma_pag == "Dinheiro" ? arred(valor_recebido - total, 2) : 0
    banco.sql("BEGIN")
    tentar {
        seja v = banco.sql(`INSERT INTO vendas
            (total_bruto,desconto,total_venda,forma_pagamento,valor_recebido,troco,operador,obs)
            VALUES ($1,$2,$3,$4,$5,$6,$7,$8) RETURNING id`,
            [total_bruto,desc,total,forma_pag,valor_recebido,troco,operador,obs??""])
        seja vid = v[0].id
        para (item em itens) {
            banco.sql(`INSERT INTO itens_venda
                (venda_id,produto_id,nome_produto,quantidade,preco_unitario,desconto_item,subtotal)
                VALUES ($1,$2,$3,$4,$5,$6,$7)`,
                [vid,item.produto_id,item.nome,item.quantidade,
                 item.preco_unitario,item.desconto_item??0,item.subtotal])
        }
        banco.sql("COMMIT")
        retornar {sucesso: verdadeiro, venda_id: vid, troco: troco, total: total}
    } pegar (e) {
        banco.sql("ROLLBACK")
        retornar {sucesso: falso, erro: texto(e)}
    }
}

funcao cancelar_venda(id) {
    banco.sql("UPDATE vendas SET cancelada=TRUE WHERE id=$1 AND cancelada=FALSE",[id])
}

funcao relatorio_dia(data_sql) {
    retornar banco.sql(`
        SELECT forma_pagamento, COUNT(*) total_vendas,
            SUM(total_venda) faturamento, AVG(total_venda) ticket_medio
        FROM vendas WHERE DATE(data_hora)=$1 AND cancelada=FALSE
        GROUP BY forma_pagamento ORDER BY faturamento DESC`, [data_sql])
}

funcao top_produtos(data_sql) {
    retornar banco.sql(`
        SELECT p.nome, SUM(iv.quantidade) qtd, SUM(iv.subtotal) receita
        FROM itens_venda iv
        JOIN produtos p ON p.id=iv.produto_id
        JOIN vendas v   ON v.id=iv.venda_id
        WHERE DATE(v.data_hora)=$1 AND v.cancelada=FALSE
        GROUP BY p.id,p.nome ORDER BY qtd DESC LIMIT 10`, [data_sql])
}

funcao estoque_baixo() {
    retornar banco.sql(`
        SELECT p.nome, c.nome as cat, p.estoque_atual, p.estoque_minimo
        FROM produtos p LEFT JOIN categorias c ON c.id=p.categoria_id
        WHERE p.estoque_atual<=p.estoque_minimo AND p.ativo=TRUE
        ORDER BY p.estoque_atual ASC`)
}

funcao saldo_caixa(data_sql) {
    seja v = banco.sql(`SELECT COALESCE(SUM(total_venda),0) t FROM vendas
        WHERE DATE(data_hora)=$1 AND cancelada=FALSE`, [data_sql])
    seja m = banco.sql(`SELECT
        COALESCE(SUM(CASE WHEN tipo='suprimento' THEN valor ELSE 0 END),0) e,
        COALESCE(SUM(CASE WHEN tipo='sangria' THEN valor ELSE 0 END),0) s
        FROM movimentos_caixa WHERE DATE(data_hora)=$1`, [data_sql])
    seja tv=numero(v[0].t); seja e=numero(m[0].e); seja s=numero(m[0].s)
    retornar {vendas:tv, entradas:e, saidas:s, saldo:arred(tv+e-s,2)}
}

funcao gerar_cupom(venda_id, itens, total, forma, troco, operador) {
    seja l = "-".repetir(40)
    seja ls = ["     SUPERMERCADO ADVAK 5.0     ",
        "  Tecnologia em Português!  ", l,
        "Venda #" + texto(venda_id) + "  " + data_hoje() + " " + data_agora("%H:%M"),
        "Operador: " + operador, l,
        "PRODUTO              QTD   SUBTOTAL", l]
    para (item em itens) {
        seja nm = texto(item.nome).primeiros(20).padEnd(20)
        seja qt = texto(arred(item.quantidade,3)).padStart(4)
        seja sb = moeda(item.subtotal).padStart(10)
        ls.adicionar(nm + qt + sb)
    }
    ls.adicionar(l)
    ls.adicionar("TOTAL:               " + moeda(total).padStart(14))
    ls.adicionar("Forma: " + forma)
    se (forma == "Dinheiro" e troco > 0) {
        ls.adicionar("Troco:               " + moeda(troco).padStart(14))
    }
    ls.adicionar(l)
    ls.adicionar("   Obrigado pela preferência!   ")
    retornar ls.unir("\n")
}

