editor.configure(bg="#0D1117", fg="#E6EDF3",
    insertbackground="#E6EDF3",
    relief="flat", espaco_x=12, espaco_y=12, wrap="none")

seja f_sa = gui.frame(f_cod, cor="#0F172A")
f_sa.posicionar(lado="left", preencher="both", expandir=verdadeiro)
seja f_sa_top = gui.frame_horizontal(f_sa)
gui.label(f_sa_top, " ▶ Saída", negrito=verdadeiro, cor="#22C55E", tamanho=10)
