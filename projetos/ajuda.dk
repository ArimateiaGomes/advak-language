saida.configure(estado="desabilitado",
    bg="#0D1117", fg="#4EC9B0",
    relief="flat", espaco_x=12, espaco_y=12)

seja f_run = gui.frame_horizontal(tab_codigo)
gui.label(f_run, " 💡 Ctrl+Enter para executar  |  Escreva código .dk e veja o resultado ao lado", tamanho=9, cor="#64748B")
seja btn_exec = gui.botao(f_run, "  ▶  Executar  ", ao_clicar=função() { executar_codigo() }, estilo="sucesso")
btn_exec.pack(lado="direita", espaco_x=8, espaco_y=5)

// ─── ABA EXERCÍCIO ────────────────────────────────────────────────────
seja tab_ex = abas.adicionar("✏️  Exercício")
seja lbl_ex_titulo = gui.label(tab_ex, "Selecione uma lição para ver o exercício", negrito=verdadeiro, tamanho=11)
seja lbl_ex_desc   = gui.label(tab_ex, "", tamanho=10, cor="#94A3B8")
gui.separador(tab_ex)
gui.label(tab_ex, "Sua solução:", negrito=verdadeiro, tamanho=10)
seja editor_ex = gui.area_texto(tab_ex, largura=95, altura=15)
editor_ex.configure(bg="#0D1117", fg="#E6EDF3",
    insertbackground="white",
    relief="flat", espaco_x=12, espaco_y=12)
seja f_ex_b = gui.frame_horizontal(tab_ex)
seja lbl_res = gui.label(f_ex_b, "", tamanho=11)
seja btn_dica = gui.botao(f_ex_b, "💡 Ver dica", ao_clicar=função() { mostrar_dica() }, estilo="aviso")
btn_dica.pack(lado="direita", espaco_x=4, espaco_y=4)
seja btn_ver = gui.botao(f_ex_b, "✓ Verificar", ao_clicar=função() { verificar_ex() }, estilo="sucesso")
btn_ver.pack(lado="direita", espaco_x=4, espaco_y=4)

// ─── ABA REFERÊNCIA ───────────────────────────────────────────────────
