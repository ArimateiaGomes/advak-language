// "//" depois de código: divisão inteira só se o resto da linha for uma expressão; senão é comentário

testar("divisao inteira", () => {
    afirmar_igual(7 // 2, 3);
    afirmar_igual(7 // (1 + 1), 3);
});

testar("comentario que comeca com numero", () => {
    seja a = 2 ** 3;   // 2 elevado a 3 = 8
    seja b = 8 > 8;    // 8 > 8 ? falso
    afirmar_igual(a, 8);
    afirmar_igual(b, falso);
});

// Comentário de uma palavra, de um número ou com "=" logo depois de uma divisão (fora de parênteses abertos)
seja metade = 7 // 2   // metade
seja terco = (10 // 3)   // 3
seja criado = (20 // 3) + 1   // 201 = criado
seja encadeada = 100 // 5 // 2

testar("comentario depois de divisao inteira", () => {
    afirmar_igual(metade, 3);
    afirmar_igual(terco, 3);
    afirmar_igual(criado, 7);
    afirmar_igual(encadeada, 10);
});
